---
import RikMark from './RikMark.astro';
const scenarios = [
	{ name: 'Incident response', agent: 'acme/oncall', title: 'Checkout errors after a deploy.', summary: 'Investigate freely. Ask before changing production.', href: '/examples/team/incident-responder/' },
	{ name: 'Financial controls', agent: 'acme/books', title: 'A $2,400 bill waits for review.', summary: 'Reconcile transactions. Payments stay off limits.', href: '/examples/business/books/' },
	{ name: 'A shared platform', agent: 'platform', title: 'Each team gets its own boundaries.', summary: 'One deployment. Separate tools, credentials, and rules.', href: '/examples/enterprise/agents-for-every-team/' },
	{ name: 'Durable runs', agent: 'acme/oncall', title: 'A node fails. The work carries on.', summary: 'Resume the turn without blindly repeating a write.', href: '/concepts/durable-runs/' },
	{ name: 'Your day', agent: 'personal/@you/week', title: 'A plan before your first meeting.', summary: 'A standing task, with a daily budget and your rules.', href: '/examples/you/your-week/' },
];
---

<wardrik-scenario-deck class="scenario-deck" role="region" aria-roledescription="carousel" aria-label="Wardrik example scenarios">
	<div class="deck-stage">
		{scenarios.map((scenario, index) => (
			<article
				class="scenario-card"
				data-card
				data-position={index}
				aria-roledescription="slide"
				aria-label={`${index + 1} of ${scenarios.length}: ${scenario.name}`}
				aria-hidden={index !== 0 ? 'true' : undefined}
				inert={index !== 0}
			>
				<header class="scenario-header">
					<span class="scenario-brand"><RikMark /></span>
					<span class="scenario-agent">{scenario.agent}</span>
				</header>
				<div class="scenario-body">
					<p class="scenario-label">Example · {scenario.name}</p>
					<h2>{scenario.title}</h2>
					<p class="scenario-summary">{scenario.summary}</p>
					<div class="scenario-visual">
						{index === 0 && <>
							<ol class="scenario-checks">
								<li><span class="check" aria-hidden="true">✓</span>Read the alert and production logs</li>
								<li><span class="check" aria-hidden="true">✓</span>Find the deploy that changed things</li>
								<li><span class="check" aria-hidden="true">✓</span>Check the rollback runbook</li>
							</ol>
							<div class="scenario-call">
								<div class="scenario-row"><span class="state state-ask">Waiting for approval</span><span class="scenario-muted">Production</span></div>
								<strong>Run the rollback workflow</strong>
								<code>github/actions_run_trigger</code>
								<div class="scenario-row"><span class="scenario-muted">Workflow</span><code>rollback.yml</code></div>
								<div class="example-actions" aria-hidden="true"><span>Approve</span><span>Deny</span></div>
							</div>
						</>}
						{index === 1 && <>
							<div class="scenario-receipt"><span class="scenario-muted">Northwind Freight · Bill to record</span><strong>$2,400<span>.00</span></strong></div>
							<div class="scenario-table">
								<div><span>Read transactions</span><span class="state state-run">Runs</span></div>
								<div><span>Record this bill</span><span class="state state-ask">Ask accountant</span></div>
								<div><span>Make a payment</span><span class="state state-deny">Blocked</span></div>
							</div>
							<div class="scenario-rule"><span class="scenario-muted">Your policy</span><code>deny: [quickbooks/create_bill_payment]</code></div>
						</>}
						{index === 2 && <>
							<div class="platform-ceiling"><span class="scenario-muted">Org policy ceilings</span><strong>Agent rules can narrow them, never widen them.</strong></div>
							<div class="scenario-orgs">
								<div><span class="org-symbol" aria-hidden="true">P</span><strong>Payments</strong><span>Stripe · GitHub</span><span class="scenario-muted">Payments’ keys</span></div>
								<div><span class="org-symbol" aria-hidden="true">G</span><strong>Growth</strong><span>GitHub</span><span class="scenario-muted">Growth’s keys</span></div>
							</div>
							<div class="scenario-boundary"><span>Another org’s credentials</span><span class="state state-deny">No access</span></div>
						</>}
						{index === 3 && <>
							<div class="scenario-nodes">
								<div><span class="node-icon node-off" aria-hidden="true">×</span><code>node a</code><span class="scenario-muted">Lost</span></div>
								<span class="node-connection" aria-hidden="true">→</span>
								<div><span class="node-icon node-on" aria-hidden="true">✓</span><code>node b</code><span class="scenario-muted">Turn resumed</span></div>
							</div>
							<div class="scenario-table">
								<div><span>Completed call</span><span class="state state-run">Saved result</span></div>
								<div><span>Uncertain write</span><span class="state state-ask">Ask before retry</span></div>
							</div>
							<p class="scenario-note">The ledger remembers what finished. A person decides what’s uncertain.</p>
						</>}
						{index === 4 && <>
							<div class="scenario-schedule"><span class="schedule-icon" aria-hidden="true">◷</span><div><strong>06:30 UTC</strong><span class="scenario-muted">Every weekday</span></div><span class="state state-run">Scheduled</span></div>
							<div class="scenario-table">
								<div><span>Read calendar and tasks</span><span class="state state-run">Runs</span></div>
								<div><span>Block focus time</span><span class="state state-run">Runs</span></div>
								<div><span>Invite a teammate</span><span class="state state-ask">Asks you</span></div>
							</div>
							<div class="scenario-budget"><span class="scenario-muted">Model budget</span><strong>$1.00 / day</strong></div>
						</>}
					</div>
					<a class="scenario-link" href={scenario.href} aria-label={`Read about ${scenario.name.toLowerCase()}`}>Read the example <span aria-hidden="true">→</span></a>
				</div>
				<div class="deck-clock" aria-hidden="true"><span /></div>
			</article>
		))}
	</div>
	<div class="deck-controls" hidden>
		<span class="deck-counter" aria-hidden="true"><span data-counter>01</span> / 05</span>
		<div class="deck-picker" role="group" aria-label="Choose a scenario">
			{scenarios.map((scenario, index) => <button type="button" data-pick={index} aria-label={`Show ${scenario.name.toLowerCase()}`} aria-pressed={index === 0 ? 'true' : 'false'}><span /></button>)}
		</div>
		<div class="deck-buttons">
			<button type="button" data-previous aria-label="Previous scenario"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m10 3-5 5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
			<button type="button" data-toggle aria-label="Pause automatic card rotation" aria-pressed="false"><svg class="pause-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="4" y="3" width="2.5" height="10" rx=".75" /><rect x="9.5" y="3" width="2.5" height="10" rx=".75" /></svg><svg class="play-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="m5 3 8 5-8 5V3Z" /></svg></button>
			<button type="button" data-next aria-label="Next scenario"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
		</div>
	</div>
	<p class="deck-announcement" aria-live="polite" aria-atomic="true"></p>
</wardrik-scenario-deck>

<script>
	class ScenarioDeck extends HTMLElement {
		private cards: HTMLElement[] = [];
		private picks: HTMLButtonElement[] = [];
		private toggle!: HTMLButtonElement;
		private current = 0;
		private paused = false;
		private hovering = false;
		private focused = false;
		private visible = false;
		private busy = false;
		private timer: ReturnType<typeof setTimeout> | undefined;
		private remaining = 8500;
		private started = 0;
		private animation: Animation | undefined;
		private observer: IntersectionObserver | undefined;
		private controller: AbortController | undefined;
		private motion = window.matchMedia('(prefers-reduced-motion: reduce)');
		private readonly interval = 8500;

		connectedCallback() {
			if (this.controller) return;
			this.controller = new AbortController();
			const { signal } = this.controller;
			this.cards = Array.from(this.querySelectorAll<HTMLElement>('[data-card]'));
			this.picks = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-pick]'));
			this.toggle = this.querySelector<HTMLButtonElement>('[data-toggle]')!;
			this.paused = this.motion.matches;
			this.querySelector<HTMLElement>('.deck-controls')!.hidden = false;

			this.querySelector('[data-next]')!.addEventListener('click', () => this.manual(this.current + 1), { signal });
			this.querySelector('[data-previous]')!.addEventListener('click', () => this.manual(this.current - 1), { signal });
			this.picks.forEach((button, index) => button.addEventListener('click', () => this.manual(index), { signal }));
			this.toggle.addEventListener('click', () => {
				this.paused = !this.paused;
				// Explicit Play resumes while the button keeps keyboard focus.
				if (!this.paused) this.focused = false;
				this.schedule();
			}, { signal });
			const stage = this.querySelector<HTMLElement>('.deck-stage')!;
			stage.addEventListener('pointerenter', (event) => {
				if (event.pointerType !== 'mouse') return;
				this.hovering = true;
				this.schedule();
			}, { signal });
			stage.addEventListener('pointerleave', () => {
				this.hovering = false;
				this.schedule();
			}, { signal });
			this.addEventListener('focusin', () => {
				this.focused = true;
				this.schedule();
			}, { signal });
			this.addEventListener('focusout', () => {
				queueMicrotask(() => {
					this.focused = this.contains(document.activeElement);
					this.schedule();
				});
			}, { signal });
			document.addEventListener('visibilitychange', () => this.schedule(), { signal });
			this.motion.addEventListener('change', () => {
				this.paused = true;
				this.animation?.finish();
				this.schedule();
			}, { signal });
			this.observer = new IntersectionObserver(([entry]) => {
				this.visible = entry.isIntersecting;
				this.schedule();
			}, { threshold: 0.25 });
			this.observer.observe(this);
			this.update();
		}

		private manual(index: number) {
			this.paused = true;
			this.schedule();
			void this.select(index, true);
		}

		private async select(index: number, announce = false) {
			const next = (index + this.cards.length) % this.cards.length;
			if (this.busy || next === this.current) return;
			this.busy = true;
			this.schedule();
			const outgoing = this.cards[this.current];
			try {
				if (!this.motion.matches) {
					this.animation = outgoing.animate([
						{ transform: 'translate3d(0, 0, 0)', opacity: 1 },
						{ transform: 'translate3d(0, -.5rem, 0) scale(.985)', opacity: 0 },
					], { duration: 280, easing: 'cubic-bezier(.4, 0, .6, 1)', fill: 'forwards' });
					await this.animation.finished;
				}
				if (!this.isConnected) return;
				this.current = next;
				this.remaining = this.interval;
				this.update();
				if (announce) this.querySelector('.deck-announcement')!.textContent = this.cards[next].getAttribute('aria-label');
			} catch (error) {
				if (!(error instanceof DOMException && error.name === 'AbortError')) throw error;
			} finally {
				this.animation?.cancel();
				this.animation = undefined;
				this.busy = false;
				this.schedule();
			}
		}

		private update() {
			this.cards.forEach((card, index) => {
				const position = (index - this.current + this.cards.length) % this.cards.length;
				card.dataset.position = String(position);
				card.inert = position !== 0;
				if (position === 0) card.removeAttribute('aria-hidden');
				else card.setAttribute('aria-hidden', 'true');
			});
			this.picks.forEach((button, index) => button.setAttribute('aria-pressed', String(index === this.current)));
			this.querySelector('[data-counter]')!.textContent = String(this.current + 1).padStart(2, '0');
		}

		private schedule() {
			if (this.timer !== undefined) {
				this.remaining = Math.max(0, this.remaining - (performance.now() - this.started));
				clearTimeout(this.timer);
				this.timer = undefined;
			}
			if (!this.isConnected || !this.controller) return;
			const running = !this.paused && !this.hovering && !this.focused && this.visible && !document.hidden && !this.busy;
			this.dataset.running = String(running);
			this.dataset.paused = String(this.paused);
			this.toggle.setAttribute('aria-label', this.paused ? 'Play automatic card rotation' : 'Pause automatic card rotation');
			this.toggle.setAttribute('aria-pressed', String(this.paused));
			if (running) {
				this.started = performance.now();
				this.timer = setTimeout(() => {
					this.timer = undefined;
					void this.select(this.current + 1);
				}, this.remaining);
			}
		}

		disconnectedCallback() {
			clearTimeout(this.timer);
			this.controller?.abort();
			this.controller = undefined;
			this.observer?.disconnect();
			this.animation?.cancel();
		}
	}

	if (!customElements.get('wardrik-scenario-deck')) customElements.define('wardrik-scenario-deck', ScenarioDeck);
</script>

<style>
	.scenario-deck { display: block; width: 100%; padding: 1.5rem .5rem 0; text-align: start; }
	.deck-stage { display: grid; isolation: isolate; overflow: clip; overflow-clip-margin: 1.5rem; }
	.scenario-card { grid-area: 1 / 1; position: relative; display: flex; flex-direction: column; min-width: 0; border: 1px solid var(--sl-color-gray-5); border-radius: 10px; background: linear-gradient(155deg, color-mix(in srgb, var(--sl-color-gray-6) 70%, var(--sl-color-black)), var(--sl-color-black) 60%); box-shadow: 0 20px 56px -36px light-dark(rgb(16 20 24 / 0.18), rgb(0 0 0 / 0.45)); transform-origin: 50% 80%; transition: transform 520ms cubic-bezier(.22, 1, .36, 1), opacity 280ms ease; }
	.scenario-card[data-position='0'] { z-index: 5; transform: translate3d(0, 0, 0); }
	.scenario-card[data-position='1'] { z-index: 4; transform: translate3d(0, -8px, 0) scale(.98); }
	.scenario-card[data-position='2'] { z-index: 3; transform: translate3d(0, -16px, 0) scale(.96); }
	.scenario-card[data-position='3'], .scenario-card[data-position='4'] { z-index: 1; opacity: 0; transform: translate3d(0, -27px, 0) scale(.95); }
	.scenario-card:not([data-position='0']) { pointer-events: none; }
	.scenario-card:not([data-position='0']) :is(.scenario-header, .scenario-body) { visibility: hidden; }
	.scenario-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .875rem 1.25rem; border-bottom: 1px solid var(--sl-color-gray-5); }
	.scenario-brand { font-size: 1.125rem; }
	.scenario-agent { color: var(--sl-color-gray-3); font: .6875rem var(--__sl-font-mono); overflow-wrap: anywhere; }
	.scenario-body { display: flex; flex-direction: column; flex: 1; padding: 1.125rem 1.25rem; }
	.scenario-label { margin: 0 0 .5rem; color: var(--sl-color-gray-3); font-size: .6875rem; }
	h2 { margin: 0 0 .5rem; color: var(--sl-color-white); font-size: 1.125rem; font-weight: 600; letter-spacing: -.02em; line-height: 1.35; text-wrap: balance; }
	.scenario-summary { margin: 0; color: var(--sl-color-gray-3); font-size: .8125rem; line-height: 1.6; text-wrap: pretty; }
	.scenario-visual { display: flex; flex: 1; flex-direction: column; gap: 1rem; padding-block: 1.125rem; font-size: .8125rem; }
	.scenario-checks { display: grid; gap: .5rem; margin: 0; padding: 0; list-style: none; color: var(--sl-color-gray-2); font-size: .75rem; }
	.scenario-checks li { display: flex; align-items: baseline; gap: .625rem; }
	.check { color: var(--sl-color-green); }
	.scenario-call { display: flex; flex-direction: column; gap: .75rem; padding: .875rem; border: 1px solid var(--sl-color-gray-5); border-inline-start: 2px solid var(--sl-color-accent); border-radius: 8px; background: var(--sl-color-gray-6); }
	.scenario-call > strong { color: var(--sl-color-white); font-size: .875rem; font-weight: 600; }
	code { color: var(--sl-color-gray-2); font: .6875rem var(--__sl-font-mono); overflow-wrap: anywhere; }
	.scenario-row { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
	.scenario-muted { color: var(--sl-color-gray-3); font-size: .6875rem; }
	.state { display: inline-flex; align-items: center; gap: .375rem; padding: .1875rem .5rem; border-radius: 4px; font-size: .625rem; font-weight: 500; white-space: nowrap; }
	.state::before { content: ''; width: .3125rem; height: .3125rem; flex-shrink: 0; border-radius: 50%; background: currentColor; }
	.state-ask { background: var(--sl-color-accent-low); color: var(--sl-color-text-accent); }
	.state-run { background: var(--sl-color-green-low); color: var(--sl-color-green); }
	.state-deny { background: var(--sl-color-red-low); color: var(--sl-color-red); }
	.example-actions { display: flex; gap: .5rem; }
	.example-actions > span { padding: .25rem .75rem; border: 1px solid var(--sl-color-gray-5); border-radius: 5px; color: var(--sl-color-white); font-size: .6875rem; }
	.example-actions > span:first-child { background: var(--sl-color-white); color: var(--sl-color-black); }
	.scenario-link { display: inline-flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: .875rem; border-top: 1px solid var(--sl-color-gray-5); color: var(--home-link-color, var(--sl-color-text-accent)); font-size: .75rem; text-decoration: none; }
	.scenario-link:hover { color: var(--sl-color-text-accent); text-decoration: underline; text-underline-offset: 3px; }
	.scenario-receipt { display: flex; flex-direction: column; align-items: center; gap: .5rem; padding: .75rem 0; }
	.scenario-receipt > strong { color: var(--sl-color-white); font-size: 2.5rem; font-weight: 500; letter-spacing: -.04em; line-height: 1.2; }
	.scenario-receipt strong > span { color: var(--sl-color-gray-3); font-size: 1.25rem; }
	.scenario-table { overflow: hidden; border: 1px solid var(--sl-color-gray-5); border-radius: 8px; }
	.scenario-table > div { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .875rem; color: var(--sl-color-gray-2); font-size: .75rem; }
	.scenario-table > div + div { border-top: 1px solid var(--sl-color-gray-5); }
	.scenario-rule { display: flex; flex-direction: column; gap: .5rem; }
	.scenario-note { margin: 0; color: var(--sl-color-gray-3); font-size: .75rem; line-height: 1.6; text-wrap: pretty; }
	.platform-ceiling { display: flex; flex-direction: column; gap: .5rem; padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: 8px; background: var(--sl-color-gray-6); }
	.platform-ceiling > strong { color: var(--sl-color-gray-2); font-size: .8125rem; font-weight: 500; text-wrap: pretty; }
	.scenario-orgs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
	.scenario-orgs > div { display: flex; flex-direction: column; align-items: center; gap: .5rem; padding: 1rem .5rem; border: 1px solid var(--sl-color-gray-5); border-radius: 8px; color: var(--sl-color-gray-2); font-size: .75rem; }
	.org-symbol { display: grid; place-items: center; width: 1.75rem; height: 1.75rem; border: 1px solid var(--sl-color-gray-5); border-radius: 5px; color: var(--sl-color-gray-3); font-family: var(--__sl-font-mono); }
	.scenario-orgs strong { color: var(--sl-color-white); font-weight: 500; }
	.scenario-boundary { display: flex; align-items: center; justify-content: space-between; gap: .5rem; color: var(--sl-color-gray-3); font-size: .6875rem; }
	.scenario-nodes { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; padding-block: .5rem; }
	.scenario-nodes > div { display: flex; flex-direction: column; align-items: center; gap: .5rem; }
	.node-icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid var(--sl-color-gray-5); border-radius: 8px; font-size: 1.25rem; }
	.node-off { color: var(--sl-color-red); }
	.node-on { color: var(--sl-color-green); background: var(--sl-color-green-low); }
	.node-connection { color: var(--sl-color-gray-4); }
	.scenario-schedule { display: flex; align-items: center; gap: .75rem; padding: .875rem; border: 1px solid var(--sl-color-gray-5); border-radius: 8px; background: var(--sl-color-gray-6); }
	.schedule-icon { color: var(--sl-color-gray-3); font-size: 1.75rem; }
	.scenario-schedule > div { display: flex; flex: 1; flex-direction: column; gap: .125rem; }
	.scenario-schedule strong { color: var(--sl-color-white); font-size: .9375rem; font-weight: 500; }
	.scenario-budget { display: flex; justify-content: space-between; gap: 1rem; }
	.scenario-budget > strong { color: var(--sl-color-gray-2); font: .75rem var(--__sl-font-mono); }
	.deck-clock { height: 2px; margin-inline: .75rem; overflow: hidden; border-radius: 1px; }
	.deck-clock > span { display: block; height: 100%; background: var(--sl-color-gray-4); transform: scaleX(0); transform-origin: left; }
	.scenario-card[data-position='0'] .deck-clock > span { animation: reading-time 8500ms linear both; animation-play-state: paused; }
	.scenario-deck[data-running='true'] .scenario-card[data-position='0'] .deck-clock > span { animation-play-state: running; }
	.deck-controls { display: flex; align-items: center; gap: 1rem; min-height: 3.5rem; padding-inline: .25rem; }
	.deck-controls[hidden] { display: none; }
	.deck-counter { min-width: 3rem; color: var(--sl-color-gray-3); font: .625rem var(--__sl-font-mono); }
	.deck-picker { display: flex; align-items: center; }
	button { display: inline-flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; padding: 0; border: 0; border-radius: 5px; background: transparent; color: var(--sl-color-gray-3); cursor: pointer; }
	button:hover { background: var(--sl-color-gray-6); color: var(--sl-color-white); }
	.deck-picker button { width: 1.625rem; }
	.deck-picker button > span { width: .3125rem; height: .3125rem; border-radius: 50%; background: var(--sl-color-gray-4); transition: background 200ms; }
	.deck-picker button[aria-pressed='true'] > span { background: var(--sl-color-white); }
	.deck-buttons { display: flex; gap: .125rem; margin-inline-start: auto; }
	.play-icon { display: none; }
	.scenario-deck[data-paused='true'] .pause-icon { display: none; }
	.scenario-deck[data-paused='true'] .play-icon { display: block; }
	.deck-announcement { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
	@keyframes reading-time { to { transform: scaleX(1); } }
	@media (max-width: 25rem) {
		.scenario-header { padding-inline: 1rem; }
