#!/bin/sh

# Where the daemon keeps things, by the XDG base directories. A node started in the background keeps
# its pipes and logs under the state directory.
data_home="${WARDRIK_DATA_HOME:-"${XDG_DATA_HOME:-"$HOME/.local/share"}/wardrik"}"
WARDRIK_STATE_DIR="${WARDRIK_STATE_DIR:-"${XDG_STATE_HOME:-"$HOME/.local/state"}/wardrik"}"

# WARDRIK_NODE names this node as config.yaml's cluster.nodes does. A name without @ is one of
# several nodes on this machine: node a runs as wardrik_a@localhost, with a store and logs of its
# own under nodes/a/. A full name is the one node on its machine.
case "${WARDRIK_NODE:-}" in
  "") ;;

  *@*)
    RELEASE_NODE="${RELEASE_NODE:-"$WARDRIK_NODE"}"

    # A host with a dot or a colon in it is a network name or an address, which distribution
    # reaches with long names.
    case "${WARDRIK_NODE#*@}" in
      *.* | *:*) RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}" ;;
    esac

    case "${WARDRIK_NODE#*@}" in
      localhost | 127.0.0.1) ;;
      *)
        if [ -z "${WARDRIK_DIST_INTERFACE:-}" ]; then
          echo "wardrik: WARDRIK_NODE is $WARDRIK_NODE, which other nodes reach over a network, and distribution listens on loopback unless WARDRIK_DIST_INTERFACE says otherwise. Set it to this machine's address on a private network that encrypts, such as Tailscale or WireGuard, with WARDRIK_DIST_EXPOSED=1." >&2
          exit 1
        fi
        ;;
    esac
    ;;

  *)
    case "$WARDRIK_NODE" in
      *[!A-Za-z0-9_-]*)
        echo "wardrik: WARDRIK_NODE is $WARDRIK_NODE; a node on this machine is named with letters, digits, - and _" >&2
        exit 1
        ;;
    esac

    RELEASE_NODE="${RELEASE_NODE:-"wardrik_$WARDRIK_NODE@localhost"}"
    WARDRIK_DATA_DIR="${WARDRIK_DATA_DIR:-"$data_home/nodes/$WARDRIK_NODE/store"}"
    WARDRIK_STATE_DIR="$WARDRIK_STATE_DIR/nodes/$WARDRIK_NODE"
    export WARDRIK_DATA_DIR
    ;;
esac

mkdir -p "$data_home" "$WARDRIK_STATE_DIR"

RELEASE_TMP="${RELEASE_TMP:-"$WARDRIK_STATE_DIR"}"
RELEASE_NODE="${RELEASE_NODE:-wardrik@localhost}"
RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-sname}"

# The node's cookie, made once and kept where only you can read it. Nodes on one machine share it.
# Nodes on several machines need the same RELEASE_COOKIE.
cookie_file="${WARDRIK_COOKIE_FILE:-"$data_home/cookie"}"
# Nodes starting together all keep the first one written: ln makes the file only if it's missing.
if [ ! -s "$cookie_file" ]; then
  made="$cookie_file.$$"
  (umask 077 && head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$made")
  ln "$made" "$cookie_file" 2>/dev/null || true
  rm -f "$made"
fi
RELEASE_COOKIE="${RELEASE_COOKIE:-"$(cat "$cookie_file")"}"

# Distribution listens on WARDRIK_DIST_INTERFACE, an Erlang address tuple such as {100,64,0,1},
# and on loopback unless it's set. Anyone who reaches it with the cookie can run code on the node,
# and nothing it sends is encrypted, so an address beyond loopback needs WARDRIK_DIST_EXPOSED=1.
loopback='{127,0,0,1}'
interface="$(echo "${WARDRIK_DIST_INTERFACE:-$loopback}" | tr -d ' ')"

case "$interface" in
  "{127,"*) ;;
  *)
    if [ "${WARDRIK_DIST_EXPOSED:-}" != "1" ]; then
      echo "wardrik: WARDRIK_DIST_INTERFACE is $interface, beyond loopback, where anyone who reaches the node with its cookie can run code on it and nothing it sends is encrypted. Use it only on a private network that encrypts, such as Tailscale or WireGuard, and set WARDRIK_DIST_EXPOSED=1 to say so." >&2
      exit 1
    fi
    ;;
esac

# epmd, if this node starts it, listens on the same address.
ERL_EPMD_ADDRESS="${ERL_EPMD_ADDRESS:-"$(echo "$interface" | tr -d '{}' | tr ',' '.')"}"
ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -kernel inet_dist_use_interface $interface"

export WARDRIK_STATE_DIR RELEASE_TMP RELEASE_NODE RELEASE_DISTRIBUTION RELEASE_COOKIE \
  ERL_EPMD_ADDRESS ELIXIR_ERL_OPTIONS
