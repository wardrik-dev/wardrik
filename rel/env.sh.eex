#!/bin/sh

# Where the daemon keeps things, by the XDG base directories: what a person
# writes under TARS_CONFIG_DIR, the store and the cookie under the data home,
# and logs and the run_erl pipes of a node started in the background under
# TARS_STATE_DIR.
data_home="${TARS_DATA_HOME:-"${XDG_DATA_HOME:-"$HOME/.local/share"}/tars"}"
TARS_CONFIG_DIR="${TARS_CONFIG_DIR:-"${XDG_CONFIG_HOME:-"$HOME/.config"}/tars"}"
TARS_STATE_DIR="${TARS_STATE_DIR:-"${XDG_STATE_HOME:-"$HOME/.local/state"}/tars"}"
TARS_DATA_DIR="${TARS_DATA_DIR:-"$data_home/store"}"
TARS_COOKIE_FILE="${TARS_COOKIE_FILE:-"$data_home/cookie"}"
RELEASE_TMP="${RELEASE_TMP:-"$TARS_STATE_DIR/tmp"}"
export TARS_CONFIG_DIR TARS_STATE_DIR TARS_DATA_DIR TARS_COOKIE_FILE RELEASE_TMP

# The cookie is this install's own, not the one baked in at build time: it is
# read from TARS_COOKIE_FILE, written there with fresh random bytes the first
# time, and readable by this user only. RELEASE_COOKIE, when set, wins.
if [ -z "${RELEASE_COOKIE:-}" ]; then
  cookie_file="$TARS_COOKIE_FILE"

  if [ ! -s "$cookie_file" ]; then
    mkdir -p "$(dirname "$cookie_file")"
    (umask 077 && LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48 >"$cookie_file")
  fi

  RELEASE_COOKIE="$(cat "$cookie_file")"
  export RELEASE_COOKIE
fi

# Distribution listens on TARS_DIST_INTERFACE, an Erlang address tuple, and on
# loopback when it is unset. `any` listens everywhere, for a node that clusters
# over a network it trusts. Anyone who reaches this port with the cookie can
# run code on the node.
interface="${TARS_DIST_INTERFACE:-"{127,0,0,1}"}"

if [ "$interface" != "any" ]; then
  ERL_EPMD_ADDRESS="${ERL_EPMD_ADDRESS:-"$(echo "$interface" | tr -d '{} ' | tr ',' '.')"}"
  export ERL_EPMD_ADDRESS
  ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -kernel inet_dist_use_interface $interface"
  export ELIXIR_ERL_OPTIONS
fi

if [ "$interface" = "{127,0,0,1}" ]; then
  RELEASE_NODE="${RELEASE_NODE:-"$RELEASE_NAME@localhost"}"
  export RELEASE_NODE
fi
