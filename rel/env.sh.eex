#!/bin/sh

# Where the daemon keeps things, by the XDG base directories: what a person
# writes under TARS_CONFIG_DIR, the store and the cookie under the data home,
# and logs and the run_erl pipes of a node started in the background under
# TARS_STATE_DIR.
data_home="${TARS_DATA_HOME:-"${XDG_DATA_HOME:-"$HOME/.local/share"}/tars"}"
TARS_CONFIG_DIR="${TARS_CONFIG_DIR:-"${XDG_CONFIG_HOME:-"$HOME/.config"}/tars"}"
TARS_STATE_DIR="${TARS_STATE_DIR:-"${XDG_STATE_HOME:-"$HOME/.local/state"}/tars"}"

# TARS_NODE names this node as config.yaml's cluster.nodes does. A name
# without @ is one of several nodes on this machine: node a runs as
# tars_a@localhost, with a store and a state directory of its own under the
# install's, and the install's cookie. A full name is the one node on its
# machine, named on the network, with the install's directories as they are.
# TarsDaemon.Cluster.node_name/1 reads a name the same way.
case "${TARS_NODE:-}" in
  "") ;;

  *@*)
    RELEASE_NODE="${RELEASE_NODE:-"$TARS_NODE"}"

    # A host with a dot or a colon in it is a network name or an address,
    # which distribution reaches with long names.
    case "${TARS_NODE#*@}" in
      *.* | *:*) RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}" ;;
    esac

    case "${TARS_NODE#*@}" in
      localhost | 127.0.0.1) ;;

      *)
        if [ -z "${TARS_DIST_INTERFACE:-}" ]; then
          echo "tars: TARS_NODE is $TARS_NODE, which the cluster's other nodes reach over a network, and distribution listens on loopback unless TARS_DIST_INTERFACE says otherwise. Set it to this machine's address on a private network that encrypts, such as Tailscale or WireGuard, with TARS_DIST_EXPOSED=1. See SECURITY.md." >&2
          exit 1
        fi
        ;;
    esac

    export RELEASE_NODE RELEASE_DISTRIBUTION
    ;;

  *)
    case "$TARS_NODE" in
      *[!A-Za-z0-9_-]*)
        echo "tars: TARS_NODE is $TARS_NODE; a node on this machine is named with letters, digits, - and _" >&2
        exit 1
        ;;
    esac

    RELEASE_NODE="${RELEASE_NODE:-"tars_$TARS_NODE@localhost"}"
    TARS_DATA_DIR="${TARS_DATA_DIR:-"$data_home/nodes/$TARS_NODE/store"}"
    TARS_STATE_DIR="$TARS_STATE_DIR/nodes/$TARS_NODE"
    export RELEASE_NODE
    ;;
esac

TARS_DATA_DIR="${TARS_DATA_DIR:-"$data_home/store"}"
TARS_COOKIE_FILE="${TARS_COOKIE_FILE:-"$data_home/cookie"}"
RELEASE_TMP="${RELEASE_TMP:-"$TARS_STATE_DIR/tmp"}"
export TARS_CONFIG_DIR TARS_STATE_DIR TARS_DATA_DIR TARS_COOKIE_FILE RELEASE_TMP

# The node, and every command it starts, makes files only this user can
# read, and the directories the daemon writes into are made private too,
# however they were made before.
umask 077
mkdir -p "$data_home" "$TARS_DATA_DIR" "$TARS_STATE_DIR"
chmod 700 "$data_home" "$TARS_DATA_DIR" "$TARS_STATE_DIR"

# The cookie is this install's own, not the one baked in at build time: it is
# read from TARS_COOKIE_FILE, written there with fresh random bytes the first
# time, and readable by this user only. RELEASE_COOKIE, when set, wins.
if [ -z "${RELEASE_COOKIE:-}" ]; then
  cookie_file="$TARS_COOKIE_FILE"

  if [ ! -s "$cookie_file" ]; then
    mkdir -p "$(dirname "$cookie_file")"
    LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 48 >"$cookie_file"
  fi

  chmod 600 "$cookie_file"

  RELEASE_COOKIE="$(cat "$cookie_file")"
  export RELEASE_COOKIE
fi

# Distribution listens on TARS_DIST_INTERFACE, an Erlang address tuple, and on
# loopback when it is unset. `any` listens everywhere, for a node that clusters
# over a network it trusts. Anyone who reaches this port with the cookie can
# run code on the node, and nothing sent over it is encrypted. An address
# beyond loopback is refused unless TARS_DIST_EXPOSED=1 is set beside it, and a
# node started on one says so as it starts. See SECURITY.md.
interface="${TARS_DIST_INTERFACE:-"{127,0,0,1}"}"

case "$(echo "$interface" | tr -d ' ')" in
  "{127,"*)
    ;;

  *)
    if [ "${TARS_DIST_EXPOSED:-}" != "1" ]; then
      echo "tars: TARS_DIST_INTERFACE is $interface, beyond loopback, where anyone who reaches the node with its cookie can run code on it and nothing it sends is encrypted. Use it only on a private network that encrypts, such as Tailscale or WireGuard, and set TARS_DIST_EXPOSED=1 to say so." >&2
      exit 1
    fi

    case "${RELEASE_COMMAND:-}" in
      start | start_iex | daemon | daemon_iex)
        echo "tars: distribution listens on $interface, beyond loopback: anyone who reaches it with the cookie can run code on this node, and nothing it sends is encrypted." >&2
        ;;
    esac
    ;;
esac

if [ "$interface" != "any" ]; then
  ERL_EPMD_ADDRESS="${ERL_EPMD_ADDRESS:-"$(echo "$interface" | tr -d '{} ' | tr ',' '.')"}"
  export ERL_EPMD_ADDRESS
  ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -kernel inet_dist_use_interface $interface"
  export ELIXIR_ERL_OPTIONS
fi

if [ "$interface" = "{127,0,0,1}" ]; then
  RELEASE_NODE="${RELEASE_NODE:-"$RELEASE_NAME@localhost"}"
  export RELEASE_NODE
fi
