          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "events.list",
        "summary": "Read the agents' events",
        "description": "A page reads after the cursor, from the start without one. A stream reads after the cursor, from what's written next without one. Where a log was trimmed past the cursor, a wardrik.events.dropped says so, and the log is read on from the oldest event it holds.",
        "tags": [
          "Agents"
        ],
        "x-wardrik-action": "agent.events",
        "x-wardrik-effect": "read",
        "x-wardrik-subject": "agents",
        "parameters": [
          {
            "$ref": "#/components/parameters/agents"
          },
          {
            "$ref": "#/components/parameters/types"
          },
          {
            "$ref": "#/components/parameters/after"
          },
          {
            "$ref": "#/components/parameters/limit"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of their logs after the cursor, or with Accept: text/event-stream their logs as server-sent events, after the cursor and then as they are written. Each event's id is the cursor after it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "urn:wardrik:schema:v1:events"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
