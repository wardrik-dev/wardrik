    },
    "/v1/agents/{agent}": {
      "get": {
        "operationId": "agent.read",
        "summary": "Read what an agent is doing now",
        "tags": [
          "Agents"
        ],
        "x-wardrik-action": "agent.read",
        "x-wardrik-effect": "read",
        "x-wardrik-subject": "agent",
