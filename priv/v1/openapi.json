          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "operationId": "agent.define",
        "summary": "Define an agent",
        "description": "Starts the agent the definition describes, or brings the one running to it from its next turn. A definition put again replaces the last. A key nothing here supports yet answers not_supported, naming it.",
        "tags": [
          "Agents"
        ],
        "x-wardrik-action": "agent.define",
        "x-wardrik-effect": "change",
        "x-wardrik-subject": "agent",
        "parameters": [
          {
            "$ref": "#/components/parameters/agent"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "urn:wardrik:schema:v1:agent_definition"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The agent, started, or brought to the definition from its next turn.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "urn:wardrik:schema:v1:agent_snapshot"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "501": {
            "$ref": "#/components/responses/NotSupported"
          }
        }
      },
      "delete": {
        "operationId": "agent.forget",
        "summary": "Forget an agent",
        "tags": [
          "Agents"
        ],
        "x-wardrik-action": "agent.forget",
        "x-wardrik-effect": "destructive",
        "x-wardrik-subject": "agent",
        "parameters": [
          {
            "$ref": "#/components/parameters/agent"
          }
        ],
        "responses": {
          "204": {
            "description": "Forgotten: stopped, with its conversation, definition and triggers deleted."
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
