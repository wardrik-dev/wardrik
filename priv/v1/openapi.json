    "/v1/agents/{agent}/decisions": {
      "post": {
        "operationId": "agent.decide",
        "summary": "Approve or reject the calls an agent waits on",
        "description": "The decisions are taken together and recorded as the caller's. A rejection's reason is what the model is told in place of the call's answer. An approval's note is what it reads beside the answer.",
        "tags": [
          "Agents"
        ],
        "x-wardrik-action": "agent.decide",
        "x-wardrik-effect": "change",
        "x-wardrik-subject": "agent",
