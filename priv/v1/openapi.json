  "components": {
    "parameters": {
      "agent": {
        "name": "agent",
        "in": "path",
        "required": true,
        "description": "The agent's ID, as acme/triage or acme/@jon/triage, or one of its conversations, as acme/triage/C1-1696.1234, which runs on the agent's definition with a history of its own. Its slashes are sent as they are, and a conversation's last segment follows conversations/, as acme/triage/conversations/C1-1696.1234. No segment holds a colon, which names a person known elsewhere, as slack:T0123/U024BE7LH.",
        "schema": {
          "type": "string",
          "pattern": "^[^/@_:\\s][^/:\\s]*(/@[^/@_:\\s][^/:\\s]*)?/[^/@_:\\s][^/:\\s]*(/[^/@_:\\s][^/:\\s]*)?$"
        }
      },
      "interrupt": {
        "name": "interrupt",
        "in": "path",
        "required": true,
        "description": "The id of the call the agent waits on.",
        "schema": {
          "type": "string"
        }
      },
      "agents": {
        "name": "agents",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "description": "The agents to cover, by ID, as acme/triage or acme/@jon/triage, given once for each. Every agent the caller reaches where left out.",
        "schema": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^/@_:*?\\s][^/:*?\\s]*(/@[^/@_:*?\\s][^/:*?\\s]*)?/[^/@_:*?\\s][^/:*?\\s]*(/[^/@_:*?\\s][^/:*?\\s]*)?$"
          }
        }
      },
      "types": {
        "name": "types",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "description": "The event types to read, as wardrik.run.completed, given once for each. Every type where left out. A wardrik.events.dropped comes whatever the types.",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "after": {
        "name": "after",
        "in": "query",
        "required": false,
        "description": "The cursor to read after: a page's next, the id of an event a stream gave, or a snapshot's cursor.",
        "schema": {
          "type": "string"
        }
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "How many to read, 100 unless set.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "starting_after": {
        "name": "starting_after",
        "in": "query",
        "required": false,
        "description": "The sequence to read after, a page's next.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "call": {
        "name": "call",
        "in": "path",
        "required": true,
        "description": "The id of the tool call.",
        "schema": {
          "type": "string"
        }
      },
      "trigger": {
        "name": "trigger",
        "in": "path",
        "required": true,
        "description": "The trigger's name.",
        "schema": {
          "type": "string",
          "pattern": "^[^/:\\s]+$"
        }
      },
      "secret": {
        "name": "secret",
        "in": "path",
        "required": true,
        "description": "The webhook's secret, for a service that only takes a URL.",
        "schema": {
          "type": "string"
        }
      },
      "channel": {
        "name": "channel",
        "in": "path",
        "required": true,
        "description": "The channel's name, as the Wardrik was given it.",
        "schema": {
          "type": "string",
          "pattern": "^[^/\\s]+$"
        }
      },
      "path": {
        "name": "path",
        "in": "path",
        "required": true,
        "description": "What the chat app sends to, within the channel, as events.",
        "schema": {
          "type": "string",
          "pattern": "^[^/\\s]+$"
        }
      }
    },
    "responses": {
      "Invalid": {
        "description": "The input doesn't read: invalid_request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "No credential, or one that isn't known or has expired: unauthorized.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The caller may not do this: forbidden.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "NotFound": {
        "description": "No such agent, or one the caller doesn't reach: not_found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "Conflict": {
        "description": "It conflicts with what's there, like a call the agent doesn't wait on: conflict.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "NotSupported": {
        "description": "What was asked isn't supported here yet.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "It can't be done now; try again later.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "What the host's authenticator takes."
      }
    }
  }
}
