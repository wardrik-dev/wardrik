          "Agents"
        ],
        "x-wardrik-action": "agent.events",
        "x-wardrik-effect": "read",
        "x-wardrik-subject": "agents",
        "parameters": [
          {
            "$ref": "#/components/parameters/agents"
          }
        ],
        "responses": {
          "200": {
            "description": "The cursor at the end of every log.",
