{
  "openapi": "3.1.0",
  "info": {
    "title": "Wardrik",
    "version": "1",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "description": "Wardrik's operations. Each is named by its operationId, everywhere it's offered: over HTTP, in the CLI, as an agent's tool. x-wardrik-action is what a caller must be allowed to do, x-wardrik-effect whether it reads, changes or destroys, and x-wardrik-subject what it acts on: one agent, many agents, or the deployment. An agent the caller reaches none of is answered as one that doesn't exist."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "Agents",
      "description": "Talking to agents, and reading what they did."
    },
    {
      "name": "Deployment",
      "description": "The deployment itself."
    }
  ],
  "paths": {
    "/v1/agents": {
      "get": {
        "operationId": "agents.list",
        "summary": "List the agents",
        "tags": [
          "Agents"
        ],
        "x-wardrik-action": "agent.read",
        "x-wardrik-effect": "read",
        "x-wardrik-subject": "agents",
        "parameters": [
          {
            "$ref": "#/components/parameters/agents"
          }
        ],
        "responses": {
          "200": {
            "description": "The agents.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "urn:wardrik:schema:v1:agents"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "delete": {
        "operationId": "agents.forget",
        "summary": "Forget the agents",
        "description": "Each agent goes as agent.forget takes it: stopped, with its conversation, definition and triggers deleted.",
        "tags": [
          "Agents"
        ],
        "x-wardrik-action": "agent.forget",
        "x-wardrik-effect": "destructive",
        "x-wardrik-subject": "agents",
        "parameters": [
          {
            "$ref": "#/components/parameters/agents"
          }
        ],
        "responses": {
          "200": {
            "description": "What it forgot, what it kept, and what it couldn't.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "urn:wardrik:schema:v1:forgotten"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
