---
import Hero from '@astrojs/starlight/components/Hero.astro';
import { LinkButton } from '@astrojs/starlight/components';
import Wordmark from './Wordmark.astro';
import ScenarioDeck from './ScenarioDeck.astro';

const isHome = Astro.url.pathname === '/';
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

{isHome ? (
	<section class="home-hero" aria-labelledby="_top">
		<div class="home-brand">
			<Wordmark />
			<span>Agents, governed.</span>
		</div>
		<div class="hero">
			<div class="stack">
				<div class="copy">
					<h1 id="_top" data-page-title set:html={title} />
					{tagline && <div class="tagline" set:html={tagline} />}
				</div>
				<div class="actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
						<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
							{text}
							{icon?.html && <Fragment set:html={icon.html} />}
						</LinkButton>
					))}
				</div>
			</div>
			<div class="hero-html"><ScenarioDeck /></div>
		</div>
	</section>
) : <Hero />}

<style>
	.hero { display: grid; align-items: center; }
	.stack, .copy { display: flex; flex-direction: column; }
	.stack { gap: 2rem; min-width: 0; }
	.copy { gap: 1rem; }
	.hero-html { min-width: 0; margin-inline: auto; }
	h1 { margin: 0; color: var(--sl-color-white); }
	.actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem 2rem; }
	@media (max-width: 50rem) {
		.stack { text-align: center; }
		.actions { justify-content: center; }
	}
</style>
