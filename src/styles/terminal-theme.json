{
	"name": "Wardrik code",
	"type": "dark",
	"colors": {
		"editor.background": "#0f1115",
		"editor.foreground": "#e6e8eb",
		"editor.selectionBackground": "#23272e",
		"editorLineNumber.foreground": "#6b737e"
	},
	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8c949e" } },
		{ "scope": ["string", "string.quoted", "string.unquoted", "markup.inline.raw"], "settings": { "foreground": "#a7d4b0" } },
		{ "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other", "support.constant"], "settings": { "foreground": "#f5d08a" } },
		{ "scope": ["keyword", "storage", "storage.type", "support.function.builtin", "entity.name.function", "support.function", "entity.name.tag", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#fdba8c" } },
		{ "scope": ["entity.name.type", "entity.name.class", "entity.other.attribute-name", "support.class", "variable.other.constant"], "settings": { "foreground": "#f5d08a" } },
		{ "scope": ["variable", "variable.parameter", "punctuation", "meta.embedded"], "settings": { "foreground": "#c9ced4" } },
		{ "scope": ["markup.heading", "markup.bold"], "settings": { "foreground": "#f4f5f7", "fontStyle": "bold" } },
		{ "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#f38b82" } }
	]
}
