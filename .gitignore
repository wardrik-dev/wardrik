# What each Mix project under packages/ and tools/ writes beside itself:
# compiled artifacts, dependency sources, coverage, generated docs and the
# dialyzer PLTs CI caches.
_build/
deps/
cover/
doc/
**/priv/plts/

# Temporary files, for example, what tests write under tmp_dir.
tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Package tarballs, built via "mix hex.build".
wardrik*-*.tar
.env
*.log

# The tarball `docker build --target tarball` writes.
/dist/
