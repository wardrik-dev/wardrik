# A person in the loop

```elixir
Mix.install([{:wardrik, "~> 0.1.0-rc.6"}, {:kino, "~> 0.19"}])
```

## Setup

An agent asks to pay two large bills. You approve one and deny the other. Add
`ANTHROPIC_API_KEY` in the Secrets panel. A run costs about a cent.

```elixir
System.put_env("ANTHROPIC_API_KEY", System.fetch_env!("LB_ANTHROPIC_API_KEY"))

defmodule MyApp.Books do
  @behaviour WardrikCore.Capability

  @impl true
  def tools(_context, _opts) do
    [
      WardrikCore.Tool.new!(
        name: "pay_bill",
        description: "Pays a vendor's bill, in dollars.",
        schema: [vendor: [type: :string, required: true], amount: [type: :integer, required: true]],
        run: fn %{vendor: vendor, amount: amount}, _ctx -> {:ok, "Paid #{vendor} $#{amount}."} end
      )
    ]
  end
end

defmodule MyApp.AllowAll do
  @behaviour Wardrik.Authorizer
  def authorize(_request, _opts), do: :ok
end

defmodule MyApp.Agents do
  @behaviour Wardrik.Resolver
  def resolve(_request, _opts), do: {:ok, %Wardrik.Resolved{principal: Wardrik.principal("maria")}}
end

{:ok, _} =
  Wardrik.start_link(
    name: MyApp.AgentRuntime,
    authorizer: {MyApp.AllowAll, []},
    resolver: {MyApp.Agents, []},
    capabilities: [books: MyApp.Books]
  )

scope = Wardrik.as(MyApp.AgentRuntime, "maria")

{:ok, _agent} =
  Wardrik.Agent.define(scope, "agt_books",
    model: "anthropic:claude-haiku-4-5",
    instructions: "You pay Maria's bills. Pay every bill she names, each with its own pay_bill call.",
    tools: ["books"],
    policy: [
      ask: %{"pay_bill(amount >= 1000)" => "A bill this size needs a person."},
      budget: [usd: 0.10, per: :day]
    ]
  )
```

## An inbox

`Wardrik.Interrupts.list/2` returns the waiting calls. Each gets a form:

```elixir
defmodule MyApp.Inbox do
  def render(frame, scope, arguments) do
    {:ok, waiting} = Wardrik.Interrupts.list(scope)

    cards =
      case waiting do
        [] -> [Kino.Markdown.new("_Nothing waits on you._")]
        waiting -> Enum.map(waiting, &card(scope, &1, arguments[&1.tool_call_id]))
      end

    Kino.Frame.render(frame, Kino.Layout.grid(cards))
  end

  def decide(scope, interrupt, %{decision: :approve, text: note}),
    do: Wardrik.Agent.approve(scope, [interrupt: interrupt] ++ said(:note, note))

  def decide(scope, interrupt, %{decision: :deny, text: reason}),
    do: Wardrik.Agent.deny(scope, [interrupt: interrupt] ++ said(:reason, reason))

  defp card(scope, interrupt, arguments) do
    form =
      Kino.Control.form(
        [
          decision: Kino.Input.select("Decision", approve: "Approve", deny: "Deny"),
          text: Kino.Input.text("Note or reason")
        ],
        submit: "Decide"
      )

    outcome = Kino.Frame.new()

    Kino.listen(form, fn %{data: data} ->
      Kino.Frame.render(outcome, Kino.Text.new(inspect(decide(scope, interrupt, data))))
    end)

    Kino.Layout.grid([
      Kino.Markdown.new("**#{interrupt.name}** `#{JSON.encode!(arguments)}`\n\n#{interrupt.message}"),
      form,
      outcome
    ])
  end

  defp said(_key, ""), do: []
  defp said(key, text), do: [{key, text}]
end
```

## Follow the agent

The inbox redraws each time the agent stops to wait:

```elixir
inbox = Kino.Frame.new()
log = Kino.Frame.new()

{:ok, cursor} = Wardrik.Events.head(scope, agents: ["agt_books"])
{:ok, events} = Wardrik.Events.stream_list(scope, after: cursor, agents: ["agt_books"])

Kino.listen(events, %{}, fn {event, _cursor}, arguments ->
  data = event.data
  call = get_in(data, ["tool", "call"])

  line =
    case event.type do
      "wardrik.run.interrupted" ->
        MyApp.Inbox.render(inbox, scope, arguments)
        "Waits on you for #{length(data["interrupts"])} call(s)."

      "wardrik.interrupt.resolved" ->
        "You #{data["decision"]} `#{data["interrupt"]["id"]}`. #{data["note"] || data["reason"]}"

      "wardrik.tool_call.completed" ->
        "`#{data["tool"]["name"]}` #{data["status"]}"

      "wardrik.run.completed" ->
        MyApp.Inbox.render(inbox, scope, arguments)
        "Run completed."

      _other ->
        ""
    end

  if line != "", do: Kino.Frame.append(log, Kino.Markdown.new(line))

  arguments =
    if event.type == "wardrik.tool_call.started",
      do: Map.put(arguments, call["id"], call["arguments"]),
      else: arguments

  {:cont, arguments}
end)
```

## Ask for two payments

Approve Initech with a note. Deny Globex with a reason.

```elixir
Kino.Layout.grid([inbox, log], columns: 2) |> Kino.render()

Wardrik.Agent.reply(scope, "agt_books", "Pay Initech's $9400 bill and Globex's $2100 bill.")
```

- An approval runs the call. The note reaches the model beside the result.
- A denial reaches the model as the call's error.
- The model carries on once no call waits.

## In code

`Wardrik.Agent.decide/2` decides several at once:

<!-- livebook:{"force_markdown":true} -->

```elixir
Wardrik.Agent.decide(scope,
  agent: "agt_books",
  decisions: %{
    initech.id => {:approve, "Pay it from the ops account."},
    globex.id => {:deny, "Not before the 1st."}
  }
)
```

