# Crash recovery

```elixir
Mix.install([{:wardrik, "~> 0.1.0-rc.7"}, {:kino, "~> 0.19"}])
```

## Setup

Kill an agent mid-call and it comes back. A safe lookup runs again. A card charge waits for a
person, so nobody pays twice. Add `ANTHROPIC_API_KEY` in the Secrets panel.

```elixir
System.put_env("ANTHROPIC_API_KEY", System.fetch_env!("LB_ANTHROPIC_API_KEY"))
Logger.configure(level: :warning)
```

Two slow tools. Only `check_stock` is `idempotent`. A table counts their runs:

```elixir
:ets.new(:tool_runs, [:named_table, :public])

defmodule MyApp.Shop do
  @behaviour WardrikCore.Capability

  @impl true
  def tools(_context, _opts) do
    [
      WardrikCore.Tool.new!(
        name: "check_stock",
        description: "Says how many of a product the warehouse has.",
        schema: [sku: [type: :string, required: true]],
        annotations: [read_only: true, idempotent: true],
        run: fn %{sku: sku}, _context ->
          ran("check_stock")
          {:ok, "#{sku}: 3 in stock."}
        end
      ),
      WardrikCore.Tool.new!(
        name: "charge_card",
        description: "Charges the customer's card, in dollars.",
        schema: [amount: [type: :integer, required: true]],
        run: fn %{amount: amount}, _context ->
          ran("charge_card")
          {:ok, "Charged $#{amount}."}
        end
      )
    ]
  end

  defp ran(tool) do
    :ets.update_counter(:tool_runs, tool, 1, {tool, 0})
    Process.sleep(3_000)
  end
end
```

## Start Wardrik on disk

Agents kept on disk outlive Wardrik. It looks for orphaned agents every second here:

```elixir
defmodule MyApp.AllowAll do
  @behaviour Wardrik.Authorizer
  def authorize(_request, _opts), do: :ok
end

defmodule MyApp.Agents do
  @behaviour Wardrik.Resolver
  def resolve(_request, _opts), do: {:ok, %Wardrik.Resolved{principal: Wardrik.principal("maria")}}
end

dir = Path.join(System.tmp_dir!(), "wardrik-#{System.unique_integer([:positive])}")

opts = [
  name: MyApp.AgentRuntime,
  authorizer: {MyApp.AllowAll, []},
  resolver: {MyApp.Agents, []},
  capabilities: [shop: MyApp.Shop],
  store: {WardrikStore.EKV, data_dir: dir},
  discovery_interval_ms: 1_000
]

{:ok, wardrik} = Wardrik.start_link(opts)
scope = Wardrik.as(MyApp.AgentRuntime, "maria")

{:ok, agent} =
  Wardrik.Agent.define(scope, "agt_shop",
    model: "anthropic:claude-haiku-4-5",
    instructions: "You run Maria's shop. Use your tools. Be brief.",
    tools: ["shop"]
  )

# Waits until the agent runs a tool call.
running = fn agent ->
  Stream.repeatedly(fn ->
    Process.sleep(100)
    Wardrik.Agent.calls(scope, agent)
  end)
  |> Stream.take(300)
  |> Enum.find_value(fn
    {:ok, [call | _]} -> call
    _none -> nil
  end)
end

# Follows the log until the run ends.
run_end = fn agent, cursor ->
  {:ok, events} = Wardrik.Agent.stream_events(scope, agent, after: cursor)
  ends = ~w(wardrik.run.completed wardrik.run.interrupted wardrik.run.failed)
  Enum.find_value(events, fn {event, _cursor} -> if event.type in ends, do: event end)
end
```

## Kill it mid-lookup

```elixir
{:ok, _message} = Wardrik.Agent.ask(scope, agent, "How many SKU-7 do we have?")
running.(agent)
```

```elixir
pid = WardrikCore.whereis(MyApp.AgentRuntime.Agents, "agt_shop")
Process.exit(pid, :kill)
```

Within a second it's back, and finishes on its own:

```elixir
{:ok, cursor} = Wardrik.Events.head(scope, agents: [agent.id])
run_end.(agent, cursor).type
```

The lookup ran twice. The model never knew:

```elixir
:ets.tab2list(:tool_runs)
```

## Restart Wardrik mid-charge

```elixir
{:ok, _message} = Wardrik.Agent.ask(scope, agent, "Charge Maria's card $40 for order 1042.")
running.(agent)
```

```elixir
:ok = Supervisor.stop(wardrik)
{:ok, wardrik} = Wardrik.start_link(opts)

{:ok, cursor} = Wardrik.Events.head(scope, agents: [agent.id])
run_end.(agent, cursor).type
```

The charge may have gone through, so the agent asks:

```elixir
{:ok, [in_doubt]} = Wardrik.Interrupts.list(scope)
in_doubt.reason
```

## Decide

```elixir
outcome = Kino.Frame.new()

decide = fn decided ->
  case decided do
    {:ok, _decisions} ->
      runs = :ets.lookup_element(:tool_runs, "charge_card", 2)
      Kino.Frame.render(outcome, Kino.Text.new("Times charge_card ran: #{runs}"))

    {:error, error} ->
      Kino.Frame.render(outcome, Kino.Text.new(error.message))
  end
end

went_through = Kino.Control.button("It went through")
charge_again = Kino.Control.button("Charge again")

Kino.listen(went_through, fn _click ->
  decide.(Wardrik.Agent.deny(scope, agent: agent, interrupt: in_doubt.id, reason: "It went through."))
end)

Kino.listen(charge_again, fn _click ->
  decide.(Wardrik.Agent.approve(scope, agent: agent, interrupt: in_doubt.id))
end)

Kino.Layout.grid([Kino.Layout.grid([went_through, charge_again], columns: 2), outcome], gap: 12)
```

To make a tool safe to repeat, give it an idempotency key and mark it `idempotent: true`.

