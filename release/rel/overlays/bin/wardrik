#!/bin/sh
# The command a person runs. Each subcommand is one of bin/wardrikd's, the node's
# own script, with the daemon's defaults around it.
set -e

readlink_f () {
  cd "$(dirname "$1")" > /dev/null
  filename="$(basename "$1")"
  if [ -h "$filename" ]; then
    readlink_f "$(readlink "$filename")"
  else
    echo "$(pwd -P)/$filename"
  fi
}

root="$(CDPATH='' cd "$(dirname "$(readlink_f "$0")")/.." && pwd -P)"
node="$root/bin/wardrikd"
config_dir="${WARDRIK_CONFIG_DIR:-"${XDG_CONFIG_HOME:-"$HOME/.config"}/wardrik"}"
state_dir="${WARDRIK_STATE_DIR:-"${XDG_STATE_HOME:-"$HOME/.local/state"}/wardrik"}"
data_home="${WARDRIK_DATA_HOME:-"${XDG_DATA_HOME:-"$HOME/.local/share"}/wardrik"}"

# The env file: one NAME=value a line, after an optional export, for the keys
# and tokens config.yaml names. Each variable this environment does not set
# already is set from it, for every command and the node they start, so a
# shell and the service read the same. Blank lines and comments are passed
# over, and wardrik doctor names any other line that sets no variable.
WARDRIK_ENV_FILE="${WARDRIK_ENV_FILE:-"$config_dir/env"}"
export WARDRIK_ENV_FILE
if [ -r "$WARDRIK_ENV_FILE" ]; then
  while read -r line || [ -n "$line" ]; do
    line="${line#export }"
    name="${line%%=*}"
    case "$line" in
      "$name" | [!A-Za-z_]*) continue ;;
    esac
    case "$name" in
      *[!A-Za-z0-9_]*) continue ;;
    esac
    eval "[ -z \"\${$name+set}\" ]" || continue
    if (eval "export $line") 2> /dev/null; then
      eval "export $line"
    else
      echo "wardrik: $WARDRIK_ENV_FILE sets $name to what sh cannot read; check its quoting" >&2
    fi
  done < "$WARDRIK_ENV_FILE"
fi

# Says so where others can read the env file, as the node starts.
env_file_private () {
  if [ -n "$(find "$WARDRIK_ENV_FILE" \( -perm -040 -o -perm -004 \) 2> /dev/null)" ]; then
    echo "wardrik: $WARDRIK_ENV_FILE can be read by others; chmod 600 it" >&2
  fi
  return 0
}

# --node NAME, anywhere among the arguments, is WARDRIK_NODE for this command:
# which of the cluster's nodes it starts, stops or asks. Everything else keeps
# its order.
count=$#
while [ "$count" -gt 0 ]; do
  arg=$1
  shift
  count=$((count - 1))

  case "$arg" in
    --node)
      [ "$count" -gt 0 ] || { echo "wardrik: --node needs a node's name" >&2; exit 1; }
      WARDRIK_NODE=$1
      export WARDRIK_NODE
      shift
      count=$((count - 1))
      ;;
    --node=*)
      WARDRIK_NODE=${arg#--node=}
      export WARDRIK_NODE
      ;;
    *)
      set -- "$@" "$arg"
      ;;
  esac
done

# The terminal this command writes to, for the node, which has none of its own:
# how wide it is, whether it takes colour, which it does where standard output
# is a terminal and NO_COLOR is not set, whether someone can type into it, and
# the account typing, whom what the command changes is recorded for. See
# WardrikDaemon.CLI.Terminal.
colour=plain
input=no-input
width="${COLUMNS:-}"
if [ -t 1 ]; then
  [ -n "${NO_COLOR:-}" ] || colour=colour
  [ -n "$width" ] || width="$(stty size 2> /dev/null < /dev/tty | cut -d' ' -f2)" || width=""
fi
[ ! -t 0 ] || input=input
user="${USER:-$(id -un 2> /dev/null)}"
terminal="--terminal=${width:-80},$colour,$input,user=$user"

# -h or --help, anywhere, is help for the command it follows, except among the
# words a shell asks completions for.
[ "${1:-}" = __complete ] || for arg in "$@"; do
  case "$arg" in
    -h | --help) help_asked=1 ;;
  esac
done

# The nodes this install has run on this machine, as cluster.nodes names them:
# each has a state directory of its own.
local_nodes () {
  for dir in "$state_dir"/nodes/*/; do
    [ -d "$dir" ] && basename "$dir"
  done
  return 0
}

# A command for one node needs to know which, once there is more than one.
one_node () {
  [ -n "${WARDRIK_NODE:-}" ] && return 0
  nodes="$(local_nodes | tr '\n' ' ')"
  if [ -n "$nodes" ]; then
    echo "wardrik: this install runs nodes $(echo $nodes | sed 's/ /, /g'); say which with --node" >&2
    exit 1
  fi
}

# A command for the cluster asks the first of this install's nodes that
# answers.
any_node () {
  [ -n "${WARDRIK_NODE:-}" ] && return 0
  for name in $(local_nodes); do
    WARDRIK_NODE="$name"
    if running; then
      export WARDRIK_NODE
      return 0
    fi
  done
  unset WARDRIK_NODE
}

# Where the node WARDRIK_NODE names logs, as rel/env.sh.eex places it.
node_state_dir () {
  case "${WARDRIK_NODE:-}" in
    "" | *@*) echo "$state_dir" ;;
    *) echo "$state_dir/nodes/$WARDRIK_NODE" ;;
  esac
}

# The name the node WARDRIK_NODE names runs under, as rel/env.sh.eex names it.
release_node () {
  case "${WARDRIK_NODE:-}" in
    "")
      case "${WARDRIK_DIST_INTERFACE:-"{127,0,0,1}"}" in
        "{127,0,0,1}") echo "${RELEASE_NODE:-wardrikd@localhost}" ;;
        *) echo "${RELEASE_NODE:-wardrikd}" ;;
      esac
      ;;
    *@*) echo "${RELEASE_NODE:-$WARDRIK_NODE}" ;;
    *) echo "${RELEASE_NODE:-wardrik_$WARDRIK_NODE@localhost}" ;;
  esac
}

# The name the node runs under, where WARDRIK_NODE says, and a pattern matching
# any of this release's nodes where it does not.
node_name () {
  case "${WARDRIK_NODE:-}" in
    "") echo "[^ ]*" ;;
    *) release_node ;;
  esac
}

# Evaluates the Erlang expression $1 on the node with the erl_call in this
# release's ERTS, and prints what it writes. Returns 0 where the expression
# comes to ok, 1 where it comes to error or raises, with what it raised on
# standard error, and 2 where no node answers.
call () {
  target="$(release_node)"
  case "${RELEASE_DISTRIBUTION:-}" in
    name | sname) mode="$RELEASE_DISTRIBUTION" ;;
    *)
      case "${target#*@}" in
        *.* | *:*) mode=name ;;
        *) mode=sname ;;
      esac
      ;;
  esac
  cookie="${RELEASE_COOKIE:-"$(cat "${WARDRIK_COOKIE_FILE:-"$data_home/cookie"}" 2> /dev/null)"}" || return 2
  [ -n "$cookie" ] || return 2
  out="$(printf '%s\n' "$1" | "$root"/erts-*/bin/erl_call "-$mode" "$target" -c "$cookie" -fetch_stdout -e 2> /dev/null)" || return 2

  # erl_call ends with the expression's result: {ok, Value}, or {error, Reason}
  # where it raised. A command that needs this terminal answers live, and
  # prints nothing first.
  ok='{ok, ok}'
  failed='{ok, error}'
  live='{ok, live}'
  raised='{error, '
  case "$out" in
    *"$ok")
      printf %s "${out%"$ok"}"
      ;;
    *"$failed")
      printf %s "${out%"$failed"}"
      return 1
      ;;
    *"$live")
      return 4
      ;;
    *)
      written="${out%"$raised"*}"
      printf %s "$written"
      echo "wardrik: ${out#"$written"}" >&2
      return 1
      ;;
  esac
}

running () {
  call ok. > /dev/null 2>&1
}

# A node on this machine that never opened its store, such as one started
# under a name the cluster does not have, leaves no directories behind.
forget_unstarted () {
  case "${WARDRIK_NODE:-}" in
    "" | *@*) return 0 ;;
  esac
  store="$data_home/nodes/$WARDRIK_NODE/store"
  if [ -d "$store" ] && [ -z "$(ls -A "$store")" ]; then
    rm -rf "${data_home:?}/nodes/$WARDRIK_NODE" "${state_dir:?}/nodes/$WARDRIK_NODE"
  fi
}

# The arguments as a list for the expression $1 names, erlang or elixir, each
# base64 encoded, so nothing a person types is read as part of the expression.
encoded () {
  syntax=$1
  shift
  list=""
  for arg in "$@"; do
    arg="$(printf %s "$arg" | base64 | tr -d '\n')"
    case "$syntax" in
      erlang) list="$list, 'Elixir.Base':'decode64!'(<<\"$arg\">>)" ;;
      elixir) list="$list, Base.decode64!(\"$arg\")" ;;
    esac
  done
  echo "[${list#, }]"
}

# Runs WardrikDaemon.CLI.main/1 on the node, and exits 1 where the command
# fails. Where no node answers, WardrikDaemon.CLI.offline/1 says why, and a
# command that needs this terminal runs again live.
cli () {
  call "try 'Elixir.WardrikDaemon.CLI':main($(encoded erlang "$terminal" "$@")) catch exit:{shutdown, 1} -> error; exit:{shutdown, live} -> live end." || {
    case $? in
      2) offline "$@" ;;
      4) live "$@" ;;
    esac
    exit 1
  }
}

# Runs WardrikDaemon.CLI.live/1 on the node through bin/wardrikd rpc, under
# this VM's group leader: what the command writes reaches this terminal as it
# goes, and what is typed here reaches the command. Ctrl-C ends this VM at
# once, without the break menu, and the command on the node with it.
live () {
  ELIXIR_ERL_OPTIONS="+Bd ${ELIXIR_ERL_OPTIONS:-}" exec "$node" rpc "WardrikDaemon.CLI.live($(encoded elixir "$terminal" "$@"))"
}

# Opens the file that declares the agent wardrik agent edit names in the
# editor, here, where the terminal is, then reads the files again. The node
# says where the file is, or why there is none.
edit () {
  shift 2
  file="$(call "try 'Elixir.WardrikDaemon.CLI':main($(encoded erlang "$terminal" __agent_file "$@")) catch exit:{shutdown, 1} -> error end.")" || {
    status=$?
    [ "$status" -ne 2 ] || offline agent edit "$@"
    printf '%s\n' "$file" >&2
    exit 1
  }
  ${VISUAL:-${EDITOR:-vi}} "$file"
  cli reload
}

# Runs WardrikDaemon.CLI.offline/1 on a VM of its own, which needs no daemon:
# help, a name that is no command, and a command no daemon is there to answer.
offline () {
  WARDRIK_LOG=- exec "$node" eval "WardrikDaemon.CLI.offline($(encoded elixir "$terminal" "$@"))"
}

# The node's VM, whether or not it answers yet: it runs this release's own
# ERTS, under the node's name. Without pgrep, as on a system with no procps,
# it is taken to be there until it answers or the wait ends.
alive () {
  command -v pgrep > /dev/null 2>&1 || return 0
  pgrep -f "$root/erts-[^/]*/bin/beam.* -s?name $(node_name)( |\$)" > /dev/null 2>&1
}

# -- service ---------------------------------------------------------------

unit_dir="${XDG_CONFIG_HOME:-"$HOME/.config"}/systemd/user"

# The unit that runs the node WARDRIK_NODE names: wardrik.service for the one
# node of an install, and an instance of wardrik@.service for each node of a
# cluster on this machine.
unit_name () {
  case "${WARDRIK_NODE:-}" in
    "") echo "wardrik.service" ;;
    *@*)
      echo "wardrik: service install runs nodes on this machine; name one as cluster.nodes does, such as a" >&2
      exit 1
      ;;
    *) echo "wardrik@$WARDRIK_NODE.service" ;;
  esac
}

# The wardrik a unit runs: the release the install script points current at
# where it installed this one, so an upgrade takes effect when the service
# restarts, and this release where it did not.
launcher () {
  current="$(dirname "$root")/current"
  if [ -L "$current" ] && [ "$(cd "$current" && pwd -P)" = "$root" ]; then
    echo "$current/bin/wardrik"
  else
    echo "$root/bin/wardrik"
  fi
}

# The units install writes, each as `==> NAME` and its text. The directories
# and the env file are this command's, so the service reads and keeps what
# this install does.
units () {
  unit_name > /dev/null
  wardrik="$(launcher)"

  case "${WARDRIK_NODE:-}" in
    "")
      echo "==> wardrik.service"
      unit "wardrik" "" "$state_dir/log/wardrik.log"
      ;;
    *)
      echo "==> epmd.service"
      cat << UNIT
# How the nodes of this machine find one another, as a unit of its own so
# stopping one node leaves every other's name in place. Written by wardrik
# service install.
[Unit]
Description=epmd, for the wardrik nodes

[Service]
ExecStart=/bin/sh -c 'exec "$(dirname "$(dirname "$wardrik")")"/erts-*/bin/epmd -address 127.0.0.1'
Restart=on-failure
UNIT
      echo "==> wardrik@.service"
      unit "wardrik node %i" "%i" "$state_dir/nodes/%i/log/wardrik.log"
      ;;
  esac
}

# A unit running the node $2 names, or the install's one node where $2 is
# empty, described as $1 and logging to $3.
unit () {
  cat << UNIT
# The wardrik daemon, as your user's systemd runs it. Written by wardrik
# service install; wardrik service uninstall removes it.
[Unit]
Description=$1
UNIT

  if [ -n "$2" ]; then
    printf 'Requires=epmd.service\nAfter=epmd.service\n'
  fi

  cat << UNIT

[Service]
Type=exec
Environment=LANG=C.UTF-8
Environment="WARDRIK_CONFIG_DIR=$config_dir"
Environment="WARDRIK_DATA_HOME=$data_home"
Environment="WARDRIK_STATE_DIR=$state_dir"
Environment="WARDRIK_LOG=$3"
Environment="WARDRIK_ENV_FILE=$WARDRIK_ENV_FILE"
UNIT

  if [ -n "$2" ]; then
    printf 'Environment=WARDRIK_NODE=%s\nEnvironment="ELIXIR_ERL_OPTIONS=-start_epmd false"\n' "$2"
  fi

  cat << UNIT
ExecStart="$wardrik" serve
ExecStop="$wardrik" stop
TimeoutStopSec=90
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
UNIT
}

# Why the daemon cannot be a service of this user's here, or nothing.
unserviceable () {
  if [ "$(id -u)" = 0 ]; then
    echo "service install runs the daemon as you, and you are root, whose home it would keep its store in; install it as the user it should run as"
  elif [ "$(uname -s)" != Linux ] || ! command -v systemctl > /dev/null 2>&1; then
    echo "service install writes a systemd unit, and this system has no systemd; run wardrik serve under what supervises services here"
  elif ! systemctl --user show-environment > /dev/null 2>&1; then
    echo "systemctl cannot reach your user's systemd, which a login over SSH or at a desktop starts and su does not; log in as $(id -un), or run: sudo loginctl enable-linger $(id -un)"
  fi
}

service_install () {
  name="$(unit_name)"
  why="$(unserviceable)"
  [ -z "$why" ] || { echo "wardrik: $why" >&2; exit 1; }

  if running && ! systemctl --user is-active --quiet "$name"; then
    echo "wardrik is running already, outside systemd; stop it with wardrik stop, and install the service again" >&2
    exit 1
  fi

  mkdir -p "$unit_dir"
  units | awk -v dir="$unit_dir" '
    /^==> / { if (out) close(out); out = dir "/" substr($0, 5); next }
    { print > out }
  '

  systemctl --user daemon-reload
  systemctl --user enable --quiet "$name"
  systemctl --user restart "$name"

  # The user's systemd, and so the daemon, runs from boot rather than from
  # their first login once they linger.
  if [ "$(loginctl show-user "$(id -un)" --property=Linger --value 2> /dev/null)" != yes ] &&
    ! loginctl enable-linger "$(id -un)" 2> /dev/null; then
    lingering="It starts once you log in; to start it at boot, run: sudo loginctl enable-linger $(id -un)"
  else
    lingering="It starts at boot."
  fi

  for tick in $(seq 600); do
    if waiting="$(call "'Elixir.IO':puts('Elixir.WardrikDaemon.CLI':started())." 2> /dev/null)"; then
      [ -z "$waiting" ] || echo "$waiting"
      echo "wardrik runs as $name, from $unit_dir. $lingering"
      exit 0
    fi
    [ "$tick" -lt 10 ] || systemctl --user is-active --quiet "$name" || break
    sleep 0.1
  done

  echo "wardrik did not start. What systemd says:" >&2
  systemctl --user status --no-pager --lines=20 "$name" >&2 || true
  exit 1
}

service_uninstall () {
  name="$(unit_name)"
  systemctl --user disable --now --quiet "$name" 2> /dev/null || true

  case "$name" in
    wardrik.service)
      rm -f "$unit_dir/wardrik.service"
      ;;
    *)
      # The template and epmd go with the last node.
      if [ -z "$(systemctl --user list-units --all --no-legend 'wardrik@*' 2> /dev/null)" ]; then
        systemctl --user disable --now --quiet epmd.service 2> /dev/null || true
        rm -f "$unit_dir/wardrik@.service" "$unit_dir/epmd.service"
      fi
      ;;
  esac

  systemctl --user daemon-reload 2> /dev/null || true
  echo "wardrik no longer runs as $name. What it keeps is where it was: $data_home"
}

[ -z "${help_asked:-}" ] || offline help "$@"

case "${1:-}" in
  serve | start | stop | remote | logs | pid | doctor | service) one_node ;;
  attach | version | help | completion | init | "") ;;
  *) any_node ;;
esac

log="${WARDRIK_LOG:-"$(node_state_dir)/log/wardrik.log"}"

case "${1:-}" in
  serve)
    env_file_private
    WARDRIK_LOG="${WARDRIK_LOG:--}" exec "$node" start
    ;;
  start)
    if running; then echo "wardrik is already running" >&2; exit 1; fi
    env_file_private
    "$node" daemon
    # Started once the agent files have been read, or once the node is up and
    # waiting for enough of its cluster to start them: WardrikDaemon.CLI.started/0
    # says which, and raises before either. The VM has a second to appear
    # before its absence ends the wait.
    for tick in $(seq 600); do
      sleep 0.1
      if waiting="$(call "'Elixir.IO':puts('Elixir.WardrikDaemon.CLI':started())." 2>/dev/null)"; then
        [ -z "$waiting" ] || echo "$waiting"
        exit 0
      fi
      [ "$tick" -lt 10 ] || alive || break
    done
    echo "wardrik did not start. The end of $log:" >&2
    tail -n 20 "$log" >&2 2>/dev/null || true
    forget_unstarted
    exit 1
    ;;
  stop)
    pid="$(call 'io:format("~s~n", [os:getpid()]).' 2>/dev/null)" || { echo "wardrik is not running" >&2; exit 1; }
    # A node without its cluster's quorum halts rather than stopping, and says
    # why; see WardrikDaemon.CLI.stopping/0.
    halting="$(call "'Elixir.IO':puts('Elixir.WardrikDaemon.CLI':stopping())." 2>/dev/null)" || halting=""
    if [ -n "$halting" ]; then
      echo "$halting"
    else
      call "'Elixir.System':stop()." > /dev/null
    fi
    for _ in $(seq 600); do
      kill -0 "$pid" 2>/dev/null || exit 0
      sleep 0.1
    done
    echo "wardrik did not stop within a minute" >&2
    exit 1
    ;;
  status)
    if ! running; then echo "wardrik is not running"; exit 3; fi
    cli "$@"
    ;;
  doctor)
    WARDRIK_LOG=- exec "$node" eval "WardrikDaemon.Doctor.main()"
    ;;
  attach)
    exec ssh -t -p "${WARDRIK_SSH_PORT:-2222}" "${USER}@${2:-localhost}"
    ;;
  remote)
    exec "$node" remote
    ;;
  logs)
    exec tail -F "$log"
    ;;
  pid)
    call 'io:format("~s~n", [os:getpid()]).' || { echo "wardrik is not running" >&2; exit 1; }
    ;;
  service)
    case "${2:-}" in
      install) service_install ;;
      uninstall) service_uninstall ;;
      status) exec systemctl --user status "$(unit_name)" ;;
      unit) units ;;
      *) offline "$@" ;;
    esac
    ;;
  version)
    echo "wardrik $(cut -d' ' -f2 "$root/releases/start_erl.data")"
    ;;
  "" | help)
    [ $# -eq 0 ] || shift
    offline help "$@"
    ;;
  completion)
    offline "$@"
    ;;
  agent)
    case "${2:-}" in
      edit) edit "$@" ;;
      *) cli "$@" ;;
    esac
    ;;
  init)
    # Answered on a VM of its own, as help is, since no daemon need run yet.
    # See WardrikDaemon.CLI.Init.
    WARDRIK_LOG=- exec "$node" eval "WardrikDaemon.CLI.Init.main($(encoded elixir "$terminal" "$@"))"
    ;;
  *)
    cli "$@"
    ;;
esac
