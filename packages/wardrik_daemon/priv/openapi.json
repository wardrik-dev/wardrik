{
  "openapi": "3.1.0",
  "info": {
    "title": "Wardrik daemon",
    "version": "1",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "description": "The daemon's own routes, beside Wardrik's operations (see Wardrik's openapi.json, at /v1/openapi.json). Each takes the same bearer tokens, and is decided by config.yaml's roles and bindings: x-wardrik-action is what a caller must be allowed to do, on the resource x-wardrik-resource names. Agents are made here, so the daemon mints each one's ID; Wardrik's agent.define refuses an ID the daemon didn't mint. Tokens are in no org, so only a binding in * reaches them. A caller always manages their own connections. An owner is one path segment: acme for an org, acme%2F%40jon for a person, or deployment. A resource the caller reaches none of is answered as one that doesn't exist."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "Agents",
      "description": "The agents each org and person makes, and their names."
    },
    {
      "name": "Ceilings",
      "description": "The budgets an org's agents share."
    },
    {
      "name": "Servers",
      "description": "The MCP servers orgs and people add for their agents."
    },
    {
      "name": "Notify targets",
      "description": "The webhooks orgs and people add for their agents' notices."
    },
    {
      "name": "OAuth apps",
      "description": "The OAuth apps orgs and people add for their people to sign in with."
    },
    {
      "name": "Connections",
      "description": "The accounts each caller connects for their agents."
    },
    {
      "name": "Tokens",
      "description": "The tokens the HTTP API is reached with."
    }
  ],
  "paths": {
    "/v1/owners/{owner}/agents": {
      "get": {
        "operationId": "agents.find",
        "summary": "Find the agents of an owner's org, by name",
        "description": "The agents in the owner's org that the caller may read, each with its ID, name, org and owner. A name is unique in its org, so name finds one at most. An agent the caller may not read, or one forgotten, isn't listed.",
        "tags": [
          "Agents"
        ],
        "x-wardrik-action": "agent.read",
        "x-wardrik-resource": "agent",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          },
          {
            "$ref": "#/components/parameters/agent_name"
          }
        ],
        "responses": {
          "200": {
            "description": "The agents.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/agent_records"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "operationId": "agents.create",
        "summary": "Make an agent for an owner",
        "description": "Mints the agent's ID, keeps its record, and defines it as Wardrik's agent.define does, as the caller. The body is the agent's name and its definition. Its workspace.shared names agents of its org as agent:NAME. A name another agent of the org has is a conflict, unless that agent was forgotten. Making one is the verb create on the kind agent, in the owner's org; the owner may make its own.",
        "tags": [
          "Agents"
        ],
        "x-wardrik-action": "agent.create",
        "x-wardrik-resource": "agent",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/agent_input"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The agent's record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/agent_record"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/v1/owners/{owner}/ceilings": {
      "get": {
        "operationId": "ceilings.list",
        "summary": "List an org's ceilings",
        "description": "Each budget the org's policies pool, with what its agents have spent against it in its period now.",
        "tags": [
          "Ceilings"
        ],
        "x-wardrik-action": "ceiling.read",
        "x-wardrik-resource": "ceiling",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          }
        ],
        "responses": {
          "200": {
            "description": "The org's ceilings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ceilings"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/connections/{provider}/pair": {
      "post": {
        "operationId": "connections.pair",
        "summary": "Finish the caller's browser sign-in",
        "description": "Sends the code the sign-in's page showed. It finishes only the sign-in the caller started. A code that's used, expired, wrong or someone else's fails the same way, and 5 wrong codes end the sign-in.",
        "tags": [
          "Connections"
        ],
        "x-wardrik-action": "connection.connect",
        "x-wardrik-resource": "connection",
        "parameters": [
          {
            "$ref": "#/components/parameters/connection_provider"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/pairing_input"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The account, connected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "urn:wardrik:schema:v1:connection"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/tokens": {
      "get": {
        "operationId": "tokens.list",
        "summary": "List tokens",
        "description": "Every token, by ID, never its secret.",
        "tags": [
          "Tokens"
        ],
        "x-wardrik-action": "token.read",
        "x-wardrik-resource": "token",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The tokens.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/tokens"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "operationId": "tokens.create",
        "summary": "Create a token",
        "description": "A token that acts as its subject, with its groups, until it expires. Its secret is answered this once: only its hash is kept. The resource is the subject, so a rule's names can say which subjects a caller may make tokens for. A token for user:admin is the admin's alone to make, whatever the caller's bindings.",
        "tags": [
          "Tokens"
        ],
        "x-wardrik-action": "token.create",
        "x-wardrik-resource": "token",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/token_input"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The token, with its secret.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/token_created"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/tokens/{id}": {
      "delete": {
        "operationId": "tokens.revoke",
        "summary": "Revoke a token",
        "description": "It stops working at once. Revoking none answers as revoking one does.",
        "tags": [
          "Tokens"
        ],
        "x-wardrik-action": "token.delete",
        "x-wardrik-resource": "token",
        "parameters": [
          {
            "$ref": "#/components/parameters/token_id"
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked."
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/tokens/web": {
      "post": {
        "operationId": "tokens.web",
        "summary": "Create a dashboard sign-in link",
        "description": "Returns a link that signs the caller in to the web dashboard. The link expires after two minutes. Signing in creates a token for the caller. The token expires after 12 hours. Only user tokens can sign in. Returns not_found while web.enabled is false.",
        "tags": [
          "Tokens"
        ],
        "x-wardrik-action": "token.create",
        "x-wardrik-resource": "token",
        "parameters": [],
        "responses": {
          "201": {
            "description": "The sign-in link.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "description": "Open it in a browser to sign in."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "owner": {
        "name": "owner",
        "in": "path",
        "required": true,
        "description": "The owner, as acme for an org, acme%2F%40jon for a person, or deployment.",
        "schema": {
          "type": "string"
        }
      },
      "connection_provider": {
        "name": "provider",
        "in": "path",
        "required": true,
        "description": "The account's name, as connections.list answers it.",
        "schema": {
          "type": "string",
          "pattern": "^[^/\\s]+$"
        }
      },
      "token_id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The token's ID.",
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        }
      },
      "agent_name": {
        "name": "name",
        "in": "query",
        "required": false,
        "description": "The agent's name, as triage. Every agent of the org unless set.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Invalid": {
        "description": "The request doesn't read: invalid_request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "No token, or one that isn't known or has expired: unauthorized.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The caller reaches the resource, but may not do this to it: forbidden.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "NotFound": {
        "description": "There's no such resource, or the caller reaches none of it: not_found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "The vault didn't answer: unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "Conflict": {
        "description": "It has one of that name already: conflict.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A token from WardrikDaemon.Tokens."
      }
    },
    "schemas": {
      "agent_input": {
        "title": "An agent to make",
        "description": "Its name, and its definition, as Wardrik's agent.define takes it.",
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "description": "Its name, unique in its org: letters, digits, _, . and -."
          }
        },
        "examples": [
          {
            "name": "notes",
            "model": "anthropic:claude-haiku-4-5",
            "instructions": "You keep Jon's notes."
          }
        ]
      },
      "agent_record": {
        "title": "An agent's record",
        "description": "Who an agent is: its ID, which the daemon minted, and its name, org and owner.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "org",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Its ID, as Wardrik's operations take it."
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "description": "Its name, unique in its org: letters, digits, _, . and -."
          },
          "org": {
            "type": "string",
            "description": "The org it's in."
          },
          "owner": {
            "$ref": "urn:wardrik:schema:v1:defs#/$defs/owner"
          }
        },
        "examples": [
          {
            "id": "agt_01JF8X5RQ2M3V9ZK0B7Y4T6WHN",
            "name": "notes",
            "org": "acme",
            "owner": "acme/@jon"
          }
        ]
      },
      "agent_records": {
        "title": "Agents' records",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agents"
        ],
        "properties": {
          "agents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/agent_record"
            }
          }
        }
      },
      "ceilings": {
        "title": "Ceilings",
        "description": "Each of an org's ceilings, with what its agents have spent against it in its period now.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ceilings"
        ],
        "properties": {
          "ceilings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ceiling",
                "per",
                "on_exhausted",
                "limit",
                "spent",
                "granted"
              ],
              "properties": {
                "ceiling": {
                  "type": "string",
                  "description": "The ceiling's name."
                },
                "per": {
                  "type": "string",
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "total"
                  ],
                  "description": "How long its limit lasts before it starts over."
                },
                "on_exhausted": {
                  "type": "string",
                  "enum": [
                    "ask",
                    "deny",
                    "continue"
                  ],
                  "description": "What the org's next model call does once they've spent it: waits on a ceiling_approval, is refused, or runs."
                },
                "limit": {
                  "$ref": "#/components/schemas/amount"
                },
                "spent": {
                  "$ref": "#/components/schemas/amount"
                },
                "granted": {
                  "$ref": "#/components/schemas/amount"
                },
                "starts_over": {
                  "type": "string",
                  "format": "date",
                  "description": "The day it starts over, in its timezone. Absent for a ceiling in total."
                }
              }
            }
          }
        },
        "examples": [
          {
            "ceilings": [
              {
                "ceiling": "plan",
                "per": "month",
                "on_exhausted": "ask",
                "limit": {
                  "usd": 20.0
                },
                "spent": {
                  "usd": 12.4,
                  "tokens": 81200
                },
                "granted": {},
                "starts_over": "2026-11-01"
              }
            ]
          }
        ]
      },
      "pairing_input": {
        "title": "A pairing code",
        "description": "The code that the sign-in page showed, in the form XXXX-XXXX. Case and the dash are ignored.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "The code, for example BCDF-GHJK."
          }
        },
        "examples": [
          {
            "code": "BCDF-GHJK"
          }
        ]
      },
      "token_input": {
        "title": "A token to create",
        "description": "The user or agent the token acts as, and when it expires. You need access to tokens to create one.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "subject"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "A label to tell tokens apart."
          },
          "subject": {
            "type": "string",
            "pattern": "^(user|agent):[^\\s]+$",
            "description": "The user or agent the token acts as. For a user, use user:ORG/@NAME, for example user:acme/@ana. For an agent, use agent:ID."
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^\\s]+$"
            },
            "description": "Groups for a user token. Access bindings can refer to these groups."
          },
          "expires_in": {
            "type": "integer",
            "minimum": 60,
            "maximum": 31536000,
            "description": "The number of seconds until the token expires, from 60 to 31536000 (one year). Defaults to 30 days."
          }
        },
        "examples": [
          {
            "name": "ana's laptop",
            "subject": "user:payments/@ana",
            "groups": [
              "payments-eng"
            ],
            "expires_in": 2592000
          }
        ]
      },
      "token": {
        "title": "A token",
        "description": "A token the HTTP API is reached with. Never its secret.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "subject",
          "groups",
          "expires"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The token's ID, which revokes it."
          },
          "name": {
            "type": "string"
          },
          "subject": {
            "type": "string",
            "description": "Who it acts as."
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expires": {
            "type": "string",
            "format": "date-time",
            "description": "When it stops working."
          }
        },
        "examples": [
          {
            "id": "mzxw6ytboi",
            "name": "ana's laptop",
            "subject": "user:payments/@ana",
            "groups": [
              "payments-eng"
            ],
            "expires": "2026-12-01T00:00:00Z"
          }
        ]
      },
      "token_created": {
        "title": "A token created",
        "description": "The token, with its secret. The secret is shown this once: only its hash is kept.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "subject",
          "groups",
          "expires",
          "secret"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The token's ID, which revokes it."
          },
          "name": {
            "type": "string"
          },
          "subject": {
            "type": "string",
            "description": "Who it acts as."
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expires": {
            "type": "string",
            "format": "date-time",
            "description": "When it stops working."
          },
          "secret": {
            "type": "string",
            "description": "Send it as Authorization: Bearer. Shown once."
          }
        },
        "examples": [
          {
            "id": "mzxw6ytboi",
            "name": "ana's laptop",
            "subject": "user:payments/@ana",
            "groups": [
              "payments-eng"
            ],
            "expires": "2026-12-01T00:00:00Z",
            "secret": "wdk_mzxw6ytboi_0123456789abcdef"
          }
        ]
      },
      "tokens": {
        "title": "Tokens",
        "description": "Every token, never a secret.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tokens"
        ],
        "properties": {
          "tokens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/token"
            }
          }
        },
        "examples": [
          {
            "tokens": [
              {
                "id": "mzxw6ytboi",
                "name": "ana's laptop",
                "subject": "user:payments/@ana",
                "groups": [
                  "payments-eng"
                ],
                "expires": "2026-12-01T00:00:00Z"
              }
            ]
          }
        ]
      },
      "amount": {
        "type": "object",
        "properties": {
          "usd": {
            "type": "number",
            "minimum": 0,
            "description": "US dollars."
          },
          "tokens": {
            "type": "integer",
            "minimum": 0,
            "description": "Tokens, input and output together."
          }
        },
        "additionalProperties": false,
        "description": "An amount in dollars, tokens or both. A limit leaves out what it doesn't limit."
      }
    }
  }
}
