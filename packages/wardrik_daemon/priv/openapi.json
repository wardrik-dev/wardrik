{
  "openapi": "3.1.0",
  "info": {
    "title": "Wardrik daemon",
    "version": "1",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "description": "The daemon's own routes, beside Wardrik's operations (see Wardrik's openapi.json, at /v1/openapi.json). Each takes the same bearer tokens, and is decided by config.yaml's roles and bindings: x-wardrik-action is what a caller must be allowed to do, on the resource x-wardrik-resource names. Agents are made here, so the daemon mints each one's ID; Wardrik's agent.define refuses an ID the daemon didn't mint. Tokens are in no org, so only a binding in * reaches them. A caller always manages their own connections. An owner is one path segment: acme for an org, acme%2F%40jon for a person, or deployment. A resource the caller reaches none of is answered as one that doesn't exist."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "Agents",
      "description": "The agents each org and person makes, and their names."
    },
    {
      "name": "Ceilings",
      "description": "The budgets an org's agents share."
    },
    {
      "name": "Servers",
      "description": "The MCP servers orgs and people add for their agents."
    },
    {
      "name": "Notify targets",
      "description": "The webhooks orgs and people add for their agents' notices."
    },
    {
      "name": "OAuth apps",
      "description": "The OAuth apps orgs and people add for their people to sign in with."
    },
    {
      "name": "Connections",
      "description": "The accounts each caller connects for their agents."
    },
    {
      "name": "Tokens",
      "description": "The tokens the HTTP API is reached with."
    }
  ],
  "paths": {
    "/v1/owners/{owner}/agents": {
      "get": {
        "operationId": "agents.find",
        "summary": "Find the agents of an owner's org, by name",
        "description": "The agents in the owner's org that the caller may read, each with its ID, name, org and owner. A name is unique in its org, so name finds one at most. An agent the caller may not read, or one forgotten, isn't listed.",
        "tags": [
          "Agents"
        ],
        "x-wardrik-action": "agent.read",
        "x-wardrik-resource": "agent",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          },
          {
            "$ref": "#/components/parameters/agent_name"
          }
        ],
        "responses": {
          "200": {
            "description": "The agents.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/agent_records"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "operationId": "agents.create",
        "summary": "Make an agent for an owner",
        "description": "Mints the agent's ID, keeps its record, and defines it as Wardrik's agent.define does, as the caller. The body is the agent's name and its definition. Its workspace.shared names agents of its org as agent:NAME. A name another agent of the org has is a conflict, unless that agent was forgotten. Making one is the verb create on the kind agent, in the owner's org; the owner may make its own.",
        "tags": [
          "Agents"
        ],
        "x-wardrik-action": "agent.create",
        "x-wardrik-resource": "agent",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/agent_input"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The agent's record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/agent_record"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/v1/owners/{owner}/ceilings": {
      "get": {
        "operationId": "ceilings.list",
        "summary": "List an org's ceilings",
        "description": "Each budget the org's policies pool, with what its agents have spent against it in its period now.",
        "tags": [
          "Ceilings"
        ],
        "x-wardrik-action": "ceiling.read",
        "x-wardrik-resource": "ceiling",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          }
        ],
        "responses": {
          "200": {
            "description": "The org's ceilings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ceilings"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/owners/{owner}/notify_targets": {
      "get": {
        "operationId": "notify_targets.list",
        "summary": "List the notify targets an owner's agents route to",
        "description": "The owner's own, then a person's org's, then the deployment's, including those config.yaml gives the owner's org. The nearest of a name wins. Each says which owner holds it.",
        "tags": [
          "Notify targets"
        ],
        "x-wardrik-action": "notify_target.read",
        "x-wardrik-resource": "notify_target",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          }
        ],
        "responses": {
          "200": {
            "description": "The notify targets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/notify_targets"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "operationId": "notify_targets.add",
        "summary": "Add a webhook for an owner's agents' notices",
        "description": "An org's target serves its own agents and every agent of its people; a person's serves their agents alone. One of the owner's own by the same name is a conflict; one an org or the deployment holds is overridden. The URL must pass the deployment's egress check.",
        "tags": [
          "Notify targets"
        ],
        "x-wardrik-action": "notify_target.add",
        "x-wardrik-resource": "notify_target",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/notify_target_input"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The notify target, as it's kept.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/notify_target"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/v1/owners/{owner}/notify_targets/{name}": {
      "delete": {
        "operationId": "notify_targets.remove",
        "summary": "Remove a notify target",
        "description": "Only the owner's own. Agents routing to it find the next one out by the same name, if there's one.",
        "tags": [
          "Notify targets"
        ],
        "x-wardrik-action": "notify_target.delete",
        "x-wardrik-resource": "notify_target",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          },
          {
            "$ref": "#/components/parameters/target_name"
          }
        ],
        "responses": {
          "200": {
            "description": "The notify target, as it was.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/notify_target"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/connections": {
      "get": {
        "operationId": "connections.list",
        "summary": "List the caller's accounts",
        "description": "Each OAuth app the caller signs in with, and each MCP server's own sign-in, by the server's name. Says whether the caller holds each, and whether a sign-in to it is under way. Only the caller's own.",
        "tags": [
          "Connections"
        ],
        "x-wardrik-action": "connection.read",
        "x-wardrik-resource": "connection",
        "responses": {
          "200": {
            "description": "The caller's accounts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connections"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/connections/{provider}": {
      "post": {
        "operationId": "connections.connect",
        "summary": "Sign the caller in to an account",
        "description": "Answers that the caller holds it already, or where they sign in: the page, and for a device sign-in the code to enter there.",
        "tags": [
          "Connections"
        ],
        "x-wardrik-action": "connection.connect",
        "x-wardrik-resource": "connection",
        "parameters": [
          {
            "$ref": "#/components/parameters/connection_provider"
          }
        ],
        "responses": {
          "200": {
            "description": "The account, or where to sign in to it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connecting"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "operationId": "connections.disconnect",
        "summary": "Forget the caller's account",
        "description": "The next call that needs it asks the caller to sign in again. not_found where the caller holds no such account. Recorded in the audit.",
        "tags": [
          "Connections"
        ],
        "x-wardrik-action": "connection.delete",
        "x-wardrik-resource": "connection",
        "parameters": [
          {
            "$ref": "#/components/parameters/connection_provider"
          }
        ],
        "responses": {
          "204": {
            "description": "Removed."
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/connections/{provider}/pair": {
      "post": {
        "operationId": "connections.pair",
        "summary": "Finish the caller's browser sign-in",
        "description": "Sends the code the sign-in's page showed. It finishes only the sign-in the caller started. A code that's used, expired, wrong or someone else's fails the same way, and 5 wrong codes end the sign-in.",
        "tags": [
          "Connections"
        ],
        "x-wardrik-action": "connection.connect",
        "x-wardrik-resource": "connection",
        "parameters": [
          {
            "$ref": "#/components/parameters/connection_provider"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/pairing_input"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The account, connected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/connection"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/tokens": {
      "get": {
        "operationId": "tokens.list",
        "summary": "List tokens",
        "description": "Every token, by ID, never its secret.",
        "tags": [
          "Tokens"
        ],
        "x-wardrik-action": "token.read",
        "x-wardrik-resource": "token",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The tokens.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/tokens"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "operationId": "tokens.create",
        "summary": "Create a token",
        "description": "A token that acts as its subject, with its groups, until it expires. Its secret is answered this once: only its hash is kept. The resource is the subject, so a rule's names can say which subjects a caller may make tokens for. A token for user:admin is the admin's alone to make, whatever the caller's bindings.",
        "tags": [
          "Tokens"
        ],
        "x-wardrik-action": "token.create",
        "x-wardrik-resource": "token",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/token_input"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The token, with its secret.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/token_created"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/tokens/{id}": {
      "delete": {
        "operationId": "tokens.revoke",
        "summary": "Revoke a token",
        "description": "It stops working at once. Revoking none answers as revoking one does.",
        "tags": [
          "Tokens"
        ],
        "x-wardrik-action": "token.delete",
        "x-wardrik-resource": "token",
        "parameters": [
          {
            "$ref": "#/components/parameters/token_id"
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked."
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/tokens/web": {
      "post": {
        "operationId": "tokens.web",
        "summary": "Create a dashboard sign-in link",
        "description": "Returns a link that signs the caller in to the web dashboard. The link expires after two minutes. Signing in creates a token for the caller. The token expires after 12 hours. Only user tokens can sign in. Returns not_found while web.enabled is false.",
        "tags": [
          "Tokens"
        ],
        "x-wardrik-action": "token.create",
        "x-wardrik-resource": "token",
        "parameters": [],
        "responses": {
          "201": {
            "description": "The sign-in link.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "description": "Open it in a browser to sign in."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "owner": {
        "name": "owner",
        "in": "path",
        "required": true,
        "description": "The owner, as acme for an org, acme%2F%40jon for a person, or deployment.",
        "schema": {
          "type": "string"
        }
      },
      "target_name": {
        "name": "name",
        "in": "path",
        "required": true,
        "description": "The notify target's name.",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"
        }
      },
      "connection_provider": {
        "name": "provider",
        "in": "path",
        "required": true,
        "description": "The account's name, as connections.list answers it.",
        "schema": {
          "type": "string",
          "pattern": "^[^/\\s]+$"
        }
      },
      "token_id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The token's ID.",
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        }
      },
      "agent_name": {
        "name": "name",
        "in": "query",
        "required": false,
        "description": "The agent's name, as triage. Every agent of the org unless set.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Invalid": {
        "description": "The request doesn't read: invalid_request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "No token, or one that isn't known or has expired: unauthorized.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The caller reaches the resource, but may not do this to it: forbidden.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "NotFound": {
        "description": "There's no such resource, or the caller reaches none of it: not_found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "The vault didn't answer: unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      },
      "Conflict": {
        "description": "It has one of that name already: conflict.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "urn:wardrik:schema:v1:error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "A token from WardrikDaemon.Tokens."
      }
    },
    "schemas": {
      "agent_input": {
        "title": "An agent to make",
        "description": "Its name, and its definition, as Wardrik's agent.define takes it.",
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "description": "Its name, unique in its org: letters, digits, _, . and -."
          }
        },
        "examples": [
          {
            "name": "notes",
            "model": "anthropic:claude-haiku-4-5",
            "instructions": "You keep Jon's notes."
          }
        ]
      },
      "agent_record": {
        "title": "An agent's record",
        "description": "Who an agent is: its ID, which the daemon minted, and its name, org and owner.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "org",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Its ID, as Wardrik's operations take it."
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "description": "Its name, unique in its org: letters, digits, _, . and -."
          },
          "org": {
            "type": "string",
            "description": "The org it's in."
          },
          "owner": {
            "$ref": "urn:wardrik:schema:v1:defs#/$defs/owner"
          }
        },
        "examples": [
          {
            "id": "agt_01JF8X5RQ2M3V9ZK0B7Y4T6WHN",
            "name": "notes",
            "org": "acme",
            "owner": "acme/@jon"
          }
        ]
      },
      "agent_records": {
        "title": "Agents' records",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agents"
        ],
        "properties": {
          "agents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/agent_record"
            }
          }
        }
      },
      "ceilings": {
        "title": "Ceilings",
        "description": "Each of an org's ceilings, with what its agents have spent against it in its period now.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ceilings"
        ],
        "properties": {
          "ceilings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ceiling",
                "per",
                "on_exhausted",
                "limit",
                "spent",
                "granted"
              ],
              "properties": {
                "ceiling": {
                  "type": "string",
                  "description": "The ceiling's name."
                },
                "per": {
                  "type": "string",
                  "enum": [
                    "day",
                    "week",
                    "month",
                    "total"
                  ],
                  "description": "How long its limit lasts before it starts over."
                },
                "on_exhausted": {
                  "type": "string",
                  "enum": [
                    "ask",
                    "deny",
                    "continue"
                  ],
                  "description": "What the org's next model call does once they've spent it: waits on a ceiling_approval, is refused, or runs."
                },
                "limit": {
                  "$ref": "#/components/schemas/amount"
                },
                "spent": {
                  "$ref": "#/components/schemas/amount"
                },
                "granted": {
                  "$ref": "#/components/schemas/amount"
                },
                "starts_over": {
                  "type": "string",
                  "format": "date",
                  "description": "The day it starts over, in its timezone. Absent for a ceiling in total."
                }
              }
            }
          }
        },
        "examples": [
          {
            "ceilings": [
              {
                "ceiling": "plan",
                "per": "month",
                "on_exhausted": "ask",
                "limit": {
                  "usd": 20.0
                },
                "spent": {
                  "usd": 12.4,
                  "tokens": 81200
                },
                "granted": {},
                "starts_over": "2026-11-01"
              }
            ]
          }
        ]
      },
      "notify_target_input": {
        "title": "A notify target to add",
        "description": "A webhook that receives notifications from the owner's agents, and the secret that signs them.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$",
            "description": "The target's name. An agent sends to this target when its definition sets notify to this name, for example notify: ops. Use up to 32 letters, digits, - and _."
          },
          "url": {
            "type": "string",
            "description": "The HTTPS URL that notifications are posted to. The daemon checks the URL when you add the target and before each notification. It doesn't follow redirects."
          },
          "secret": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "description": "A secret in the owner's vault. The daemon uses it to sign the body of each notification. The daemon reads it each time, so a new value applies immediately.",
            "properties": {
              "name": {
                "type": "string",
                "description": "The name of the secret in the owner's vault."
              }
            }
          }
        },
        "examples": [
          {
            "name": "ops",
            "url": "https://hooks.acme.example/wardrik",
            "secret": {
              "name": "OPS_HOOK_SECRET"
            }
          }
        ]
      },
      "notify_target": {
        "title": "A notify target",
        "description": "A place an owner's agents' notices go: who holds it, where it came from, and what kind it is. Never its secret, nor a config target's options.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "name",
          "source",
          "kind"
        ],
        "properties": {
          "owner": {
            "$ref": "urn:wardrik:schema:v1:defs#/$defs/owner"
          },
          "name": {
            "type": "string",
            "description": "What agents' definitions route to."
          },
          "source": {
            "$ref": "urn:wardrik:schema:v1:defs#/$defs/source"
          },
          "kind": {
            "type": "string",
            "description": "What sends its notices, as webhook or room. A target added at runtime is a webhook."
          },
          "url": {
            "type": "string",
            "description": "Where a webhook posts. Omitted for other kinds."
          },
          "secret": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "description": "The vault secret that signs a runtime webhook's notices. Omitted for one without, and for a config target.",
            "properties": {
              "name": {
                "type": "string",
                "description": "The name of the secret in the owner's vault."
              }
            }
          }
        },
        "examples": [
          {
            "owner": "acme",
            "name": "ops",
            "source": "runtime",
            "kind": "webhook",
            "url": "https://hooks.acme.example/wardrik",
            "secret": {
              "name": "OPS_HOOK_SECRET"
            }
          },
          {
            "owner": "deployment",
            "name": "pager",
            "source": "config",
            "kind": "room"
          }
        ]
      },
      "notify_targets": {
        "title": "Notify targets",
        "description": "The targets an owner's agents' notices go to: their own, their org's and the deployment's. The nearest of a name wins.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targets"
        ],
        "properties": {
          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/notify_target"
            }
          }
        },
        "examples": [
          {
            "targets": [
              {
                "owner": "acme",
                "name": "ops",
                "source": "runtime",
                "kind": "webhook",
                "url": "https://hooks.acme.example/wardrik",
                "secret": {
                  "name": "OPS_HOOK_SECRET"
                }
              }
            ]
          }
        ]
      },
      "connection": {
        "title": "A connection",
        "description": "An account the caller can connect, by its provider's name, whether they hold it, and whether a sign-in to it is under way. A value is never answered.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "connected"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "description": "The account's name: an OAuth app's, or an MCP server's that makes its own sign-in."
          },
          "connected": {
            "type": "boolean",
            "description": "Whether the caller holds it, which is what a call of an agent acting for them would use."
          },
          "signing_in": {
            "type": "boolean",
            "description": "In connections.list: whether a sign-in the caller started is under way. It turns false once the sign-in is granted, declined or expires."
          }
        },
        "examples": [
          {
            "provider": "github",
            "connected": true,
            "signing_in": false
          }
        ]
      },
      "connections": {
        "title": "Connections",
        "description": "What connections.list answers: the accounts the caller can connect, and whether they hold each. A value is never answered.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connections"
        ],
        "properties": {
          "connections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/connection"
            }
          }
        },
        "examples": [
          {
            "connections": [
              {
                "provider": "github",
                "connected": true,
                "signing_in": false
              },
              {
                "provider": "linear",
                "connected": false,
                "signing_in": true
              }
            ]
          }
        ]
      },
      "connecting": {
        "title": "A connection asked for",
        "description": "What connections.connect answers: that the caller holds the account already, or where they sign in to it.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "connected"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "description": "The account's name: an OAuth app's, or an MCP server's that makes its own sign-in."
          },
          "connected": {
            "type": "boolean",
            "description": "Whether the caller holds it already."
          },
          "authorization": {
            "$ref": "urn:wardrik:schema:v1:authorization",
            "description": "Where to sign in, where it is not held yet: the page, and for a device sign-in the code to enter there."
          }
        },
        "examples": [
          {
            "provider": "github",
            "connected": true
          },
          {
            "provider": "linear",
            "connected": false,
            "authorization": {
              "url": "https://auth.example.com/authorize?client_id=…&state=…"
            }
          },
          {
            "provider": "github",
            "connected": false,
            "authorization": {
              "url": "https://github.com/login/device",
              "code": "WDJB-MJHT"
            }
          }
        ]
      },
      "pairing_input": {
        "title": "A pairing code",
        "description": "The code that the sign-in page showed, in the form XXXX-XXXX. Case and the dash are ignored.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "The code, for example BCDF-GHJK."
          }
        },
        "examples": [
          {
            "code": "BCDF-GHJK"
          }
        ]
      },
      "token_input": {
        "title": "A token to create",
        "description": "The user or agent the token acts as, and when it expires. You need access to tokens to create one.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "subject"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "A label to tell tokens apart."
          },
          "subject": {
            "type": "string",
            "pattern": "^(user|agent):[^\\s]+$",
            "description": "The user or agent the token acts as. For a user, use user:ORG/@NAME, for example user:acme/@ana. For an agent, use agent:ID."
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^\\s]+$"
            },
            "description": "Groups for a user token. Access bindings can refer to these groups."
          },
          "expires_in": {
            "type": "integer",
            "minimum": 60,
            "maximum": 31536000,
            "description": "The number of seconds until the token expires, from 60 to 31536000 (one year). Defaults to 30 days."
          }
        },
        "examples": [
          {
            "name": "ana's laptop",
            "subject": "user:payments/@ana",
            "groups": [
              "payments-eng"
            ],
            "expires_in": 2592000
          }
        ]
      },
      "token": {
        "title": "A token",
        "description": "A token the HTTP API is reached with. Never its secret.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "subject",
          "groups",
          "expires"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The token's ID, which revokes it."
          },
          "name": {
            "type": "string"
          },
          "subject": {
            "type": "string",
            "description": "Who it acts as."
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expires": {
            "type": "string",
            "format": "date-time",
            "description": "When it stops working."
          }
        },
        "examples": [
          {
            "id": "mzxw6ytboi",
            "name": "ana's laptop",
            "subject": "user:payments/@ana",
            "groups": [
              "payments-eng"
            ],
            "expires": "2026-12-01T00:00:00Z"
          }
        ]
      },
      "token_created": {
        "title": "A token created",
        "description": "The token, with its secret. The secret is shown this once: only its hash is kept.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "subject",
          "groups",
          "expires",
          "secret"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The token's ID, which revokes it."
          },
          "name": {
            "type": "string"
          },
          "subject": {
            "type": "string",
            "description": "Who it acts as."
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expires": {
            "type": "string",
            "format": "date-time",
            "description": "When it stops working."
          },
          "secret": {
            "type": "string",
            "description": "Send it as Authorization: Bearer. Shown once."
          }
        },
        "examples": [
          {
            "id": "mzxw6ytboi",
            "name": "ana's laptop",
            "subject": "user:payments/@ana",
            "groups": [
              "payments-eng"
            ],
            "expires": "2026-12-01T00:00:00Z",
            "secret": "wdk_mzxw6ytboi_0123456789abcdef"
          }
        ]
      },
      "tokens": {
        "title": "Tokens",
        "description": "Every token, never a secret.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tokens"
        ],
        "properties": {
          "tokens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/token"
            }
          }
        },
        "examples": [
          {
            "tokens": [
              {
                "id": "mzxw6ytboi",
                "name": "ana's laptop",
                "subject": "user:payments/@ana",
                "groups": [
                  "payments-eng"
                ],
                "expires": "2026-12-01T00:00:00Z"
              }
            ]
          }
        ]
      },
      "amount": {
        "type": "object",
        "properties": {
          "usd": {
            "type": "number",
            "minimum": 0,
            "description": "US dollars."
          },
          "tokens": {
            "type": "integer",
            "minimum": 0,
            "description": "Tokens, input and output together."
          }
        },
        "additionalProperties": false,
        "description": "An amount in dollars, tokens or both. A limit leaves out what it doesn't limit."
      }
    }
  }
}
