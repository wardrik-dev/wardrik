# Event logs

```elixir
Mix.install([{:wardrik, "~> 0.1.0-rc.11"}, {:kino, "~> 0.19"}])
```

## Setup

Watch an agent's events arrive, read its run back, see who changed what, and react when a run
ends.

```elixir
defmodule MyApp.Notes do
  @behaviour WardrikCore.Capability

  @impl true
  def tools(_context, _opts) do
    [
      WardrikCore.Tool.new!(
        name: "list_notes",
        description: "Lists Maria's notes.",
        run: fn _args, _context -> {:ok, ["Call Initech about the Q3 invoice.", "Book Berlin trip."]} end,
        annotations: [read_only: true]
      )
    ]
  end
end

defmodule MyApp.AllowAll do
  @behaviour Wardrik.Authorizer
  def authorize(_request, _opts), do: :ok
end

defmodule MyApp.Agents do
  @behaviour Wardrik.Resolver
  def resolve(_request, _opts), do: {:ok, %Wardrik.Resolved{principal: Wardrik.principal("maria")}}
end

defmodule MyApp.RunAlerts do
  @behaviour Wardrik.Sink

  @ends ["wardrik.run.completed", "wardrik.run.failed"]

  @impl true
  def handle_event(%Wardrik.Event{type: type} = event, opts) when type in @ends,
    do: Kino.Frame.append(opts[:frame], Kino.Markdown.new("**#{type}** for `#{event.agent}`"))

  def handle_event(_event, _opts), do: :ok
end

alerts = Kino.Frame.new()

{:ok, _} =
  Wardrik.start_link(
    name: MyApp.AgentRuntime,
    authorizer: {MyApp.AllowAll, []},
    resolver: {MyApp.Agents, []},
    capabilities: [notes: MyApp.Notes],
    sinks: [{MyApp.RunAlerts, frame: alerts}]
  )

scope = Wardrik.as(MyApp.AgentRuntime, "maria")

{:ok, agent} =
  Wardrik.Agent.define(scope, "agt_assistant",
    model: "anthropic:claude-haiku-4-5",
    instructions: "You keep Maria's notes. Be brief.",
    tools: ["notes"],
    policy: [budget: [usd: 0.25, per: :day]]
  )
```

## A sink

`MyApp.RunAlerts`, given to Wardrik as `sinks:` above, posts a line here each time a run ends. A
sink gets every kept event in the process that wrote it, so it returns quickly:

```elixir
alerts
```

## Follow events

```elixir
{:ok, cursor} = Wardrik.Events.head(scope, agents: ["agt_assistant"])
live = Kino.Frame.new() |> Kino.render()

Kino.start_child(
  {Task,
   fn ->
     {:ok, events} = Wardrik.Events.stream_list(scope, after: cursor, agents: ["agt_assistant"])

     events
     |> Stream.reject(fn {event, _cursor} -> String.ends_with?(event.type, ".delta") end)
     |> Enum.reduce([], fn {event, _cursor}, rows ->
       rows = rows ++ [%{time: event.time, type: event.type}]
       Kino.Frame.render(live, Kino.DataTable.new(rows, keys: [:time, :type]))
       rows
     end)
   end}
)

Kino.nothing()
```

Now ask the agent. Add `ANTHROPIC_API_KEY` in the Secrets panel. It costs under a cent.

```elixir
System.put_env("ANTHROPIC_API_KEY", System.fetch_env!("LB_ANTHROPIC_API_KEY"))

{:ok, reply} = Wardrik.Agent.reply(scope, agent, "What's on my notes?")
reply.text
```

## Read a run back

```elixir
{:ok, timeline} = Wardrik.Agent.timeline(scope, agent)

for %{"kind" => "run"} = run <- timeline.items, step <- run["steps"] do
  %{step: step["type"], detail: step["name"] || step["text"], status: step["status"]}
end
|> Kino.DataTable.new(keys: [:step, :detail, :status], name: "Steps")
```

```elixir
{:ok, runs} = Wardrik.Agent.runs(scope, agent)

Kino.DataTable.new(
  Enum.map(runs.runs, &Map.from_struct/1),
  keys: [:status, :model, :duration_ms, :tool_calls, :input_tokens, :output_tokens, :cost_micro_usd],
  name: "Runs"
)
```

## Read the log

```elixir
{:ok, page} = Wardrik.Agent.events(scope, agent, limit: 100)

page.events
|> Enum.frequencies_by(& &1.type)
|> Enum.map(fn {type, count} -> %{type: type, count: count} end)
|> Kino.DataTable.new(keys: [:type, :count], name: "Events by type")
```

## Who changed what

The audit records what people did. It needs `deployment.audit`:

```elixir
{:ok, _agent} =
  Wardrik.Agent.define(scope, "agt_assistant",
    model: "anthropic:claude-haiku-4-5",
    instructions: "You keep Maria's notes. Answer in bullet points.",
    tools: ["notes"]
  )

{:ok, audit} = Wardrik.Audit.list(scope, limit: 50)

audit.events
|> Enum.map(&%{time: &1.time, type: &1.type, by: &1.data["actor"]["id"], subject: &1.subject})
|> Kino.DataTable.new(keys: [:time, :type, :by, :subject], name: "Audit")
```

