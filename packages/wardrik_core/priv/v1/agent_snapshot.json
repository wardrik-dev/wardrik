{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:agent_snapshot",
  "title": "An agent's snapshot",
  "description": "The body of GET /v1/agents/{key}, and of a PUT there. cursor is where the agent's log stands: read and follow the log after it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "conversation",
    "status",
    "pending",
    "activity",
    "request",
    "run",
    "interrupts",
    "messages",
    "labels",
    "outcome",
    "cursor"
  ],
  "properties": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The agent's key, org/name, or org/@user/name for one that works for a user."
        },
        "name": {
          "type": "string"
        }
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The key and generation; it changes when the agent is forgotten and started again."
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "parked"
      ]
    },
    "pending": {
      "type": "integer",
      "minimum": 0
    },
    "activity": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/activity"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "type": "string"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "run": {
      "oneOf": [
        {
          "$ref": "urn:wardrik:schema:v1:defs#/$defs/run"
        },
        {
          "type": "null"
        }
      ],
      "description": "The run going on, or null between runs."
    },
    "interrupts": {
      "type": "array",
      "items": {
        "$ref": "urn:wardrik:schema:v1:defs#/$defs/interrupt"
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "urn:wardrik:schema:v1:defs#/$defs/message"
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What the agent's history holds, as labels, such as outside for content nobody on the agent's side wrote. Every turn carries them until the history is cleared."
    },
    "outcome": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ok",
            "failed",
            "interrupted"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "How the last run ended, or null before the first."
    },
    "cursor": {
      "type": "string",
      "description": "Where the agent's log stands, as GET /v1/events and the agent's own events take it."
    }
  },
  "examples": [
    {
      "agent": {
        "id": "acme/triage",
        "name": "triage"
      },
      "conversation": {
        "id": "acme/triage/5f1c2a"
      },
      "status": "parked",
      "pending": 0,
      "activity": {
        "doing": [
          {
            "type": "wardrik.run.interrupted",
            "interrupts": [
              {
                "id": "toolu_01",
                "reason": "tool_approval",
                "message": "Open an issue?",
                "tool_call_id": "toolu_01"
              }
            ]
          }
        ],
        "since": "2026-10-18T12:00:00.000000Z",
        "pending": 0
      },
      "request": {
        "model": "claude-sonnet-5"
      },
      "provider": {
        "name": "anthropic"
      },
      "run": {
        "id": "4bf92f3577b34da6a3ce929d0e0e4736"
      },
      "interrupts": [
        {
          "id": "toolu_01",
          "reason": "tool_approval",
          "message": "Open an issue?",
          "tool_call_id": "toolu_01"
        }
      ],
      "messages": [
        {
          "role": "user",
          "parts": [
            {
              "type": "text",
              "content": "What's on fire?"
            }
          ]
        }
      ],
      "labels": [],
      "outcome": "ok",
      "cursor": "eyJhY21lL3RyaWFnZSI6NDF9"
    }
  ]
}
