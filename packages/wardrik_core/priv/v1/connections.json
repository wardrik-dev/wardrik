{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:connections",
  "title": "Connections",
  "description": "The accounts an owner's org is offered, and whether the owner holds each: what GET /v1/connections answers. A value is never answered.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connections"
  ],
  "properties": {
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "connected"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "description": "The account's name, as the deployment configures it."
          },
          "connected": {
            "type": "boolean",
            "description": "Whether the owner holds it, which is what a call of an agent they own would use."
          }
        }
      }
    }
  },
  "examples": [
    {
      "connections": [
        {
          "provider": "github",
          "connected": true
        },
        {
          "provider": "linear",
          "connected": false
        }
      ]
    }
  ]
}
