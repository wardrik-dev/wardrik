{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:agent.defined",
  "title": "wardrik.agent.defined",
  "description": "Someone wrote an agent's definition, and the agent was started, or brought to it.",
  "type": "object",
  "properties": {
    "agent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The agent's ID."
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "actor": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/principal"
    },
    "assumed_by": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/assumed_by"
    }
  },
  "additionalProperties": false,
  "required": [
    "agent"
  ]
}
