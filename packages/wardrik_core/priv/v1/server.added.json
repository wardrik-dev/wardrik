{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:server.added",
  "title": "wardrik.server.added",
  "description": "Someone added an MCP server for an owner's agents.",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "url"
      ]
    },
    "owner": {
      "type": "string",
      "description": "The org, as acme, or the user, as acme/@jon, whose agents it serves."
    },
    "actor": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/principal"
    },
    "assumed_by": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/assumed_by"
    }
  },
  "additionalProperties": false,
  "required": [
    "server",
    "owner"
  ]
}
