{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:secret.removed",
  "title": "wardrik.secret.removed",
  "description": "Someone took a secret out of the vault.",
  "type": "object",
  "properties": {
    "secret": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "owner": {
      "type": "string",
      "description": "The org, as acme, or the user, as acme/@jon, it is kept for; none where it is the deployment's."
    },
    "actor": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/principal"
    },
    "assumed_by": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/assumed_by"
    }
  },
  "additionalProperties": false,
  "required": [
    "secret"
  ]
}
