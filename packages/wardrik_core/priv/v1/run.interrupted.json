{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:run.interrupted",
  "title": "wardrik.run.interrupted",
  "description": "A run stopped to wait on a person, for each interrupt it lists.",
  "type": "object",
  "properties": {
    "run": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/run"
    },
    "interrupts": {
      "type": "array",
      "items": {
        "$ref": "urn:wardrik:schema:v1:defs#/$defs/interrupt"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "run",
    "interrupts"
  ]
}
