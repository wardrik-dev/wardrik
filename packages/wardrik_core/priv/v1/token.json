{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:token",
  "title": "Token",
  "description": "An API token as the server keeps it, never its secret.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "principal",
    "statements",
    "policy",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "What revoking it takes."
    },
    "name": {
      "type": "string"
    },
    "principal": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/principal",
      "description": "Whom it acts for: whoever made it."
    },
    "statements": {
      "type": "array",
      "items": {
        "$ref": "urn:wardrik:schema:v1:defs#/$defs/statement"
      },
      "description": "What it allows, on what; anything none states is denied."
    },
    "policy": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The names of the hooks every agent it defines runs under, ahead of the agent's own."
    },
    "expires": {
      "type": "string",
      "format": "date-time",
      "description": "When it stops working."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
