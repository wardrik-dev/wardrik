{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:tool_call.retrying",
  "title": "wardrik.tool_call.retrying",
  "description": "A tool call that may run twice crashed or ran out of time, and runs again after a wait.",
  "type": "object",
  "properties": {
    "tool": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/tool"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "description": "Which try after the first comes next."
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "description": "How many tries after the first there may be."
    },
    "wait_ms": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/duration_ms"
    },
    "error": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/error"
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "attempt",
    "attempts",
    "wait_ms",
    "error"
  ]
}
