{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:message.completed",
  "title": "wardrik.message.completed",
  "description": "The model answered, failed, or was stopped.",
  "type": "object",
  "properties": {
    "message": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/message"
    },
    "response": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "finish_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/usage"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "cancelled"
      ]
    },
    "error": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/error"
    },
    "duration_ms": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/duration_ms"
    }
  },
  "additionalProperties": false,
  "required": [
    "message",
    "status",
    "duration_ms"
  ]
}
