{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:tool_call.completed",
  "title": "wardrik.tool_call.completed",
  "description": "A tool call answered, or was answered from the ledger when replayed.",
  "type": "object",
  "properties": {
    "tool": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/tool"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error"
      ]
    },
    "error": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/error"
    },
    "replayed": {
      "type": "boolean"
    },
    "served_by": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/served_by"
    },
    "cost": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/cost"
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "status",
    "replayed"
  ]
}
