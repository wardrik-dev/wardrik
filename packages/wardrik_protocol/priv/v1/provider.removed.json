{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:provider.removed",
  "title": "wardrik.provider.removed",
  "description": "Someone removed an OAuth app an owner had added.",
  "type": "object",
  "properties": {
    "provider": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "owner": {
      "type": "string",
      "description": "Whose people sign in with it, as your app names them."
    },
    "actor": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/principal"
    },
    "assumed_by": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/assumed_by"
    }
  },
  "additionalProperties": false,
  "required": [
    "provider",
    "owner"
  ]
}
