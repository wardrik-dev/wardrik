{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:file.written",
  "title": "wardrik.file.written",
  "description": "Someone wrote a file in an agent's workspace.",
  "type": "object",
  "properties": {
    "agent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The agent's ID."
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Its path in the workspace."
        },
        "version": {
          "type": "string",
          "description": "The version written."
        }
      }
    },
    "actor": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/principal"
    },
    "assumed_by": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/assumed_by"
    }
  },
  "additionalProperties": false,
  "required": [
    "agent",
    "file"
  ]
}
