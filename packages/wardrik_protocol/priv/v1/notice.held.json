{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:notice.held",
  "title": "wardrik.notice.held",
  "description": "A judge held a finished turn's answer back from the agent's notify targets.",
  "type": "object",
  "properties": {
    "agent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The agent's ID."
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "conversation": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/conversation_id"
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "The judge's probability that the answer should be sent."
    },
    "send": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "The probability the answer needed to be sent."
    },
    "actor": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/principal"
    },
    "assumed_by": {
      "$ref": "urn:wardrik:schema:v1:defs#/$defs/assumed_by"
    }
  },
  "additionalProperties": false,
  "required": [
    "agent",
    "probability",
    "send"
  ]
}
