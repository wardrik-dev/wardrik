{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:secrets",
  "title": "An owner's secrets",
  "description": "Each secret the owner holds, by name, and what it's for. Never a value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "secrets"
  ],
  "properties": {
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "purpose"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "api_key",
              "client_secret",
              "header",
              "signing_secret",
              "grant",
              "token",
              "secret"
            ],
            "description": "What it's for: api_key, client_secret, header or signing_secret for one the owner sealed, grant for an account they connected, token for a chat app's install, secret for one sealed with no purpose."
          }
        }
      }
    }
  },
  "examples": [
    {
      "secrets": [
        {
          "name": "ANTHROPIC_API_KEY",
          "purpose": "api_key"
        },
        {
          "name": "linear",
          "purpose": "grant"
        }
      ]
    }
  ]
}
