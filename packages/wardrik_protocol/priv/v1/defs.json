{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:defs",
  "title": "Shared definitions",
  "$defs": {
    "message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "description": "system, user, assistant or tool."
        },
        "name": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "urn:wardrik:schema:v1:defs#/$defs/part"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "parts"
      ],
      "description": "A message in OpenTelemetry's GenAI shape. On message.started and message.delta only its id is given."
    },
    "message_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "description": "A message, by its id."
    },
    "part": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "text, reasoning, tool_call, tool_call_response, uri, file or blob."
        },
        "content": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "description": "Any JSON value. Stored as a flattened field."
        },
        "response": {
          "description": "Any JSON value. Stored as a flattened field."
        },
        "modality": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "audio",
            "document"
          ]
        },
        "mime_type": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "file_id": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "One part of a message, tagged by type, as OpenTelemetry's GenAI conventions define them."
    },
    "error": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "A low-cardinality code, as OpenTelemetry's error.type."
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "message"
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "reasoning": {
          "type": "object",
          "properties": {
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Token usage, as gen_ai.usage.* without the prefix."
    },
    "cost": {
      "type": "object",
      "properties": {
        "micro_usd": {
          "type": "integer",
          "minimum": 0,
          "description": "Whole micro-dollars: 1000000 is one US dollar."
        },
        "source": {
          "type": "string",
          "enum": [
            "provider",
            "catalog",
            "tool"
          ],
          "description": "provider where the provider reported the figure, catalog where Wardrik priced the tokens at the model catalog's prices, tool where the tool reported it."
        }
      },
      "additionalProperties": false,
      "required": [
        "micro_usd",
        "source"
      ],
      "description": "What a call cost, the same figure a budget counts."
    },
    "principal": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "shell, ssh, terminal, slack, oauth, token or user."
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "description": "Who did something, and how they were known."
    },
    "decided": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "enum": [
            "hook",
            "person",
            "default",
            "ledger"
          ],
          "description": "hook where hooks allowed the call by name or one refused it, person where a person answered it, default where no hook named it and nothing asked, ledger where the ledger could not record it."
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The hooks that allowed the call, refused it, or asked a person about it."
        }
      },
      "additionalProperties": false,
      "required": [
        "by"
      ],
      "description": "Who decided a call."
    },
    "served_by": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "description": "What answered a tool call, as its tool names it: a tool worker's token, for one."
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "message_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "description": "A run, by the W3C trace id it runs under."
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "call": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "arguments": {
              "description": "Any JSON value. Stored as a flattened field."
            },
            "result": {
              "description": "Any JSON value. Stored as a flattened field."
            },
            "idempotency_key": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "id"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "call"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "interrupt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "tool_approval",
            "model_approval",
            "authorization",
            "in_doubt"
          ]
        },
        "message": {
          "type": "string"
        },
        "tool_call_id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "The tool the call is for, as the agent names it; none for a model's approval."
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The labels of what the run had read, which may be what asked for the call: outside for content nobody on the agent's side wrote."
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "reason",
        "message"
      ],
      "description": "A call a run waits on a person for."
    }
  }
}
