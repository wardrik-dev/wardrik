{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wardrik:schema:v1:runs",
  "title": "Runs",
  "description": "What agent.runs answers: each run, newest first, and the totals across them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runs",
    "totals",
    "cursor"
  ],
  "properties": {
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "started_at",
          "tool_calls",
          "tool_errors",
          "input_tokens",
          "output_tokens",
          "cost_micro_usd"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed",
              "cancelled",
              "waiting"
            ]
          },
          "started_at": {
            "type": "string"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "description": "Who sent the message it answered."
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool_calls": {
            "type": "integer",
            "minimum": 0
          },
          "tool_errors": {
            "type": "integer",
            "minimum": 0
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "cost_micro_usd": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runs",
        "failed",
        "tool_calls",
        "input_tokens",
        "output_tokens",
        "cost_micro_usd",
        "last_at"
      ],
      "properties": {
        "runs": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_micro_usd": {
          "type": "integer",
          "minimum": 0
        },
        "last_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "cursor": {
      "type": "string"
    }
  }
}
